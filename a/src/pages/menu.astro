---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortMenusForDisplay } from "../lib/carousel.js";
import { withBase } from "../lib/base.js";

const homepage = await getEntry("site", "homepage");
const menus = sortMenusForDisplay((await getCollection("menu")).map((entry) => entry.data));
---

<BaseLayout title="Moof — Menu" description="Moof specialty matcha, hojicha, and seasonal drinks menu.">
  <main class="counter-shell menu-shell">
    <header class="counter-header" aria-label="Primary navigation">
      <a class="wordmark" href={withBase("")} aria-label="Moof home">{homepage?.data.logoText ?? "Moof"}<span aria-hidden="true">.</span></a>
      <nav>
        <a href={withBase("")}>Home</a>
        <a href="#counter-menu" aria-current="page">Menu</a>
        <a class="nav-instagram" href={homepage?.data.findUs.instagramUrl ?? "https://www.instagram.com/moof__bar/"} target="_blank" rel="noreferrer" aria-label="Open Moof Instagram">IG <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <section class="menu-hero" aria-labelledby="menu-heading">
      <p class="eyebrow">The counter menu <span aria-hidden="true">✦</span></p>
      <h1 id="menu-heading">Good things, <em>whisked simply.</em></h1>
      <p>Specialty matcha, hojicha, and seasonal drinks.</p>
      <div class="menu-hero-rule" aria-hidden="true"><span>◌</span><i></i><span>◌</span></div>
    </section>

    <section id="counter-menu" class="counter-menu" aria-label="Moof drinks menu">
      {menus.map((menu, menuIndex) => (
        <section class="menu-group" aria-labelledby={`menu-group-${menuIndex}`}>
          <div class="menu-group-heading">
            <span>{menuIndex === 0 ? "01" : "02"}</span>
            <div><h2 id={`menu-group-${menuIndex}`}>{menu.title}</h2><p>{menu.description}</p></div>
          </div>
          <div class="menu-list">
            {menu.items.filter((item) => item.active).map((item) => (
              <article class="menu-row">
                <img src={withBase(item.image)} alt="" loading="lazy" />
                <div class="menu-row-main">
                  <div class="drink-title"><h3>{item.name}</h3><strong>{item.price}</strong></div>
                  <p>{item.description}</p>
                  <div class="menu-options" aria-label={`${item.name} options`}>
                    {item.isSeasonal && <span>seasonal</span>}
                    <span>{item.temperatureOptions.join(" / ")}</span>
                    <span>{item.milkOptions.join(" / ")}</span>
                  </div>
                  {item.signature && <p class="signature-line">{item.signature}</p>}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </section>

    <section class="menu-footer-note" aria-label="Visit Moof">
      <p>Find us at {homepage?.data.findUs.address}, {homepage?.data.findUs.unit}.</p>
      <a class="ink-link" href={withBase("#find-us")}>Plan a visit <span aria-hidden="true">→</span></a>
    </section>
  </main>
</BaseLayout>
