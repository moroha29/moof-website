---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortMenusForDisplay } from "../lib/carousel.js";
import { withBase } from "../lib/base.js";

const homepage = await getEntry("site", "homepage");
const menus = sortMenusForDisplay((await getCollection("menu")).map((entry) => entry.data));
---

<BaseLayout title="Moof — Menu" description="Moof specialty matcha, hojicha, and seasonal drinks menu.">
  <main class="counter-shell menu-shell">
    <header class="counter-header" aria-label="Primary navigation">
      <a class="wordmark" href={withBase("")} aria-label="Moof home">{homepage?.data.logoText ?? "Moof"}<span aria-hidden="true">.</span></a>
      <nav>
        <a href={withBase("")}>Home</a>
        <a href="#counter-menu" aria-current="page">Menu</a>
        <a class="nav-instagram" href={homepage?.data.findUs.instagramUrl ?? "https://www.instagram.com/moof__bar/"} target="_blank" rel="noreferrer" aria-label="Open Moof Instagram">IG <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <section class="menu-hero" aria-labelledby="menu-heading">
      <p class="eyebrow">The counter menu <span aria-hidden="true">✦</span></p>
      <h1 id="menu-heading">Good things, <em>whisked simply.</em></h1>
      <p>Specialty matcha, hojicha, and seasonal drinks.</p>
      <div class="menu-hero-rule" aria-hidden="true"><span>◌</span><i></i><span>◌</span></div>
    </section>

    <section id="counter-menu" class="counter-menu" aria-label="Moof drinks menu">
      {menus.map((menu, menuIndex) => (
        <section class="menu-group" aria-labelledby={`menu-group-${menuIndex}`}>
          <div class="menu-group-heading">
            <span>{menuIndex === 0 ? "01" : "02"}</span>
            <div><h2 id={`menu-group-${menuIndex}`}>{menu.title}</h2><p>{menu.description}</p></div>
          </div>
          <div class="menu-list">
            {menu.items.filter((item) => item.active).map((item) => (
              <article class="menu-row">
                <img src={withBase(item.image)} alt="" loading="lazy" />
                <div class="menu-row-main">
                  <div class="drink-title"><h3>{item.name}</h3><strong>{item.price}</strong></div>
                  <p>{item.description}</p>
                  <div class="menu-options" aria-label={`${item.name} options`}>
                    {item.isSeasonal && <span>seasonal</span>}
                    <span>{item.temperatureOptions.join(" / ")}</span>
                    <span>{item.milkOptions.join(" / ")}</span>
                  </div>
                  {item.signature && (
                    <>
                      <button type="button" class="signature-trigger" popovertarget={`signature-menu-${item.id}`}>
                        What makes it signature <span aria-hidden="true">＋</span>
                      </button>
                      <div id={`signature-menu-${item.id}`} popover class="signature-flyout">
                        <button type="button" class="signature-flyout-close" popovertarget={`signature-menu-${item.id}`} popovertargetaction="hide" aria-label="Close">✕</button>
                        <p class="signature-flyout-label">What makes it signature</p>
                        <h3>{item.name}</h3>
                        <p>{item.signature}</p>
                      </div>
                    </>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </section>

    <section class="menu-footer-note" aria-label="Visit Moof">
      <p>Find us at {homepage?.data.findUs.address}, {homepage?.data.findUs.unit}.</p>
      <a class="ink-link" href={withBase("#find-us")}>Plan a visit <span aria-hidden="true">→</span></a>
    </section>
  </main>
</BaseLayout>

<script>
  const positionSignatureFlyout = (popover: HTMLElement, event: Event) => {
    const toggleEvent = event as ToggleEvent;
    if (toggleEvent.newState !== "open") return;

    // Clear any prior inline placement first so the mobile bottom-sheet CSS can take over cleanly.
    popover.style.top = "";
    popover.style.left = "";

    if (window.innerWidth <= 640) return;

    const trigger = document.querySelector(`[popovertarget="${popover.id}"]`);
    if (!(trigger instanceof HTMLElement)) return;

    const triggerRect = trigger.getBoundingClientRect();
    const margin = 8;

    popover.style.top = `${triggerRect.bottom + margin}px`;
    popover.style.left = `${triggerRect.left}px`;

    requestAnimationFrame(() => {
      const popoverRect = popover.getBoundingClientRect();
      let top = triggerRect.bottom + margin;
      let left = triggerRect.left;

      if (left + popoverRect.width > window.innerWidth - margin) {
        left = Math.max(margin, window.innerWidth - popoverRect.width - margin);
      }

      if (top + popoverRect.height > window.innerHeight - margin) {
        const above = triggerRect.top - popoverRect.height - margin;
        top = above >= margin ? above : Math.max(margin, window.innerHeight - popoverRect.height - margin);
      }

      popover.style.top = `${top}px`;
      popover.style.left = `${left}px`;
    });
  };

  document.querySelectorAll<HTMLElement>(".signature-flyout").forEach((popover) => {
    popover.addEventListener("beforetoggle", (event) => positionSignatureFlyout(popover, event));
  });

  // A flyout anchored to a trigger's on-screen position stops making sense
  // once the page scrolls out from under it, so dismiss it rather than let
  // it float disconnected from the card that opened it.
  window.addEventListener(
    "scroll",
    () => {
      document
        .querySelectorAll<HTMLElement>(".signature-flyout:popover-open")
        .forEach((popover) => popover.hidePopover());
    },
    { passive: true }
  );
</script>
