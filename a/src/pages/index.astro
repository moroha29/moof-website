---
import { getCollection, getEntry } from "astro:content";
import AboutSection from "../components/AboutSection.astro";
import DrinkCarousel from "../components/DrinkCarousel.astro";
import FindUsSection from "../components/FindUsSection.astro";
import InstagramEmbed from "../components/InstagramEmbed.astro";
import MenuSection from "../components/MenuSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCarouselDrinks, sortMenusForDisplay } from "../lib/carousel.js";
import { getInstagramPreviewPosts } from "../lib/instagram.js";

const homepage = await getEntry("site", "homepage");
const menuEntries = await getCollection("menu");

if (!homepage) {
  throw new Error("Missing homepage content");
}

const menus = sortMenusForDisplay(menuEntries.map((entry) => entry.data));
const carouselDrinks = getCarouselDrinks(menus, homepage.data.hero.carouselDrinkIds);
const instagramPosts = getInstagramPreviewPosts(homepage.data.instagramEmbed.posts);
const navHref = (href: string, isExternal = false) => {
  if (isExternal || href.startsWith("#")) {
    return href;
  }

  return `${import.meta.env.BASE_URL}${href.replace(/^\//, "")}`;
};
---

<BaseLayout title="Moof Matcha" description="Moof specialty matcha, seasonal drinks, and Japanese ingredients Mori and Shiran.">
  <main class="site-shell">
    <header class="site-header" aria-label="Primary navigation">
      <a class="logo" href={import.meta.env.BASE_URL} aria-label="Moof home">{homepage.data.logoText}</a>
      <nav>
        {
          homepage.data.nav.map((item) => (
            <a
              class={item.external ? "nav-icon-link" : undefined}
              href={navHref(item.href, item.external)}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noreferrer" : undefined}
              aria-label={item.external ? "Open Moof Instagram" : undefined}
            >
              {item.external ? (
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.2" cy="6.8" r="1"></circle>
                </svg>
              ) : (
                item.label
              )}
            </a>
          ))
        }
      </nav>
    </header>

    <DrinkCarousel
      drinks={carouselDrinks}
      featuredDrinkId={homepage.data.hero.featuredDrinkId}
      eyebrow={homepage.data.hero.eyebrow}
      headline={homepage.data.hero.headline}
      since={homepage.data.hero.since}
      note={homepage.data.hero.note}
    />

    <InstagramEmbed
      eyebrow={homepage.data.instagramEmbed.eyebrow}
      heading={homepage.data.instagramEmbed.heading}
      body={homepage.data.instagramEmbed.body}
      label={homepage.data.instagramEmbed.label}
      url={homepage.data.instagramEmbed.url}
      posts={instagramPosts}
    />

    <section class="announcement" aria-label="Moof announcement">
      <p>{homepage.data.hero.announcement}</p>
      <span>{homepage.data.hero.note}</span>
    </section>

    <div id="menu" class="menu-stack">
      {menus.map((menu) => <MenuSection title={menu.title} description={menu.description} items={menu.items} />)}
    </div>

    <AboutSection
      heading={homepage.data.about.heading}
      body={homepage.data.about.body}
      storeNote={homepage.data.about.storeNote}
      image={homepage.data.about.image}
      ingredients={homepage.data.ingredients}
    />

    <FindUsSection
      heading={homepage.data.findUs.heading}
      body={homepage.data.findUs.body}
      address={homepage.data.findUs.address}
      unit={homepage.data.findUs.unit}
      mrtNote={homepage.data.findUs.mrtNote}
      operatingHours={homepage.data.findUs.operatingHours}
      instagramLabel={homepage.data.findUs.instagramLabel}
      instagramUrl={homepage.data.findUs.instagramUrl}
    />
  </main>
</BaseLayout>
