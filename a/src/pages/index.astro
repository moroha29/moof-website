---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TeamSection from "../components/TeamSection.astro";
import AboutSection from "../components/AboutSection.astro";
import { sortMenusForDisplay } from "../lib/carousel.js";
import { withBase } from "../lib/base.js";

const homepage = await getEntry("site", "homepage");

if (!homepage) {
  throw new Error("Missing homepage content");
}

const menus = sortMenusForDisplay((await getCollection("menu")).map((entry) => entry.data));
const activeDrinks = menus.flatMap((menu) => menu.items).filter((item) => item.active);
const featuredDrink = activeDrinks.find((item) => item.id === homepage.data.hero.featuredDrinkId) ?? activeDrinks[0];
const seasonalDrinks = menus.find((menu) => menu.seasonName)?.items.filter((item) => item.active) ?? [];
const previewDrinks = activeDrinks.slice(0, 3);
---

<BaseLayout title="Moof — Specialty Matcha" description="Moof specialty matcha, seasonal drinks, and Japanese ingredients Mori and Shiran.">
  <main class="counter-shell">
    <header class="counter-header" aria-label="Primary navigation">
      <a class="wordmark" href={withBase("")} aria-label="Moof home">{homepage.data.logoText}<span aria-hidden="true">.</span></a>
      <nav>
        <a href={withBase("menu")}>Menu</a>
        <a href="#find-us">Visit</a>
        <a class="nav-instagram" href={homepage.data.findUs.instagramUrl} target="_blank" rel="noreferrer" aria-label="Open Moof Instagram">
          IG <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <section class="counter-hero" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow"><span aria-hidden="true">✦</span> {homepage.data.hero.eyebrow}</p>
        <h1 id="hero-heading">{homepage.data.hero.headline}<em> at the counter</em></h1>
        <p class="hero-note">{homepage.data.hero.note}</p>
        <p class="pour-note">{homepage.data.hero.announcement}</p>
        <a class="ink-link" href="#today">See today's pour <span aria-hidden="true">↓</span></a>
      </div>

      {featuredDrink && (
        <figure class="hero-drink">
          <div class="doodle doodle-sun" aria-hidden="true">☼</div>
          <div class="doodle doodle-spark" aria-hidden="true">✦</div>
          <img src={withBase(featuredDrink.image)} alt={featuredDrink.name} />
          <figcaption>
            <span>featured drink</span>
            <strong>{featuredDrink.name}</strong>
            <b>{featuredDrink.price}</b>
          </figcaption>
        </figure>
      )}
    </section>

    <section id="today" class="counter-notes" aria-labelledby="today-heading">
      <div class="section-intro">
        <p class="eyebrow">Today at Moof <span aria-hidden="true">↝</span></p>
        <h2 id="today-heading">A little counter board for the current season.</h2>
      </div>
      <div class="note-grid">
        <article class="paper-note note-seasonal">
          <span class="note-pin" aria-hidden="true"></span>
          <p>Current seasonal menu</p>
          <h3>{seasonalDrinks[0]?.name ?? homepage.data.hero.announcement}</h3>
          <span>{seasonalDrinks[0]?.description}</span>
        </article>
        <article class="paper-note note-ingredients">
          <p>Our matcha shelf</p>
          <div class="ingredient-list">
            {homepage.data.ingredients.map((ingredient) => (
              <div>
                <strong>{ingredient.name}</strong>
                <span>{ingredient.origin}</span>
                <p>{ingredient.description}</p>
              </div>
            ))}
          </div>
        </article>
        <article class="paper-note note-milk">
          <p>At the bar</p>
          <h3>{homepage.data.about.storeNote}</h3>
          <span>{homepage.data.about.body}</span>
        </article>
      </div>
    </section>

    <AboutSection {...homepage.data.about} ingredients={homepage.data.ingredients} />

    <TeamSection
      eyebrow={homepage.data.team.eyebrow}
      heading={homepage.data.team.heading}
      intro={homepage.data.team.intro}
      members={homepage.data.team.members}
    />

    <section class="menu-preview" aria-labelledby="preview-heading">
      <div class="section-intro section-intro-inline">
        <div>
          <p class="eyebrow">A short pour list <span aria-hidden="true">✦</span></p>
          <h2 id="preview-heading">Pick a favourite, then make it yours.</h2>
        </div>
        <a class="button-link" href={withBase("menu")}>Full menu <span aria-hidden="true">→</span></a>
      </div>
      <div class="preview-grid">
        {previewDrinks.map((drink, index) => (
          <article class:list={["preview-card", index === 1 && "preview-card-tint"]}>
            <span class="card-number" aria-hidden="true">0{index + 1}</span>
            <img src={withBase(drink.image)} alt="" loading="lazy" />
            <div>
              <div class="drink-title"><h3>{drink.name}</h3><strong>{drink.price}</strong></div>
              <p>{drink.description}</p>
              <span class="drink-options">{drink.temperatureOptions.join(" / ")} · {drink.milkOptions.join(" / ")}</span>
              {drink.signature && (
                <>
                  <button type="button" class="signature-trigger" popovertarget={`signature-preview-${drink.id}`}>
                    What makes it signature <span aria-hidden="true">＋</span>
                  </button>
                  <div id={`signature-preview-${drink.id}`} popover class="signature-flyout">
                    <button type="button" class="signature-flyout-close" popovertarget={`signature-preview-${drink.id}`} popovertargetaction="hide" aria-label="Close">✕</button>
                    <p class="signature-flyout-label">What makes it signature</p>
                    <h3>{drink.name}</h3>
                    <p>{drink.signature}</p>
                  </div>
                </>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="find-us" class="visit-section" aria-labelledby="visit-heading">
      <div class="section-intro">
        <p class="eyebrow">Come by <span aria-hidden="true">⌇</span></p>
        <h2 id="visit-heading">Visit Moof.</h2>
        <p>{homepage.data.findUs.body}</p>
      </div>
      <div class="visit-board">
        <article>
          <span class="visit-label">Address</span>
          <strong>{homepage.data.findUs.address}</strong>
          <p>{homepage.data.findUs.unit}</p>
        </article>
        <article>
          <span class="visit-label">Getting here</span>
          <strong>{homepage.data.findUs.mrtNote}</strong>
        </article>
        <article>
          <span class="visit-label">Counter hours</span>
          <strong>{homepage.data.findUs.operatingHours}</strong>
          <a href={homepage.data.findUs.instagramUrl} target="_blank" rel="noreferrer">{homepage.data.findUs.instagramLabel} <span aria-hidden="true">↗</span></a>
        </article>
      </div>
      {homepage.data.findUs.mapEmbedUrl && (
        <div class="visit-map">
          <iframe
            src={homepage.data.findUs.mapEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map showing Moof's location"
          ></iframe>
        </div>
      )}
    </section>
  </main>
</BaseLayout>

<script>
  const positionSignatureFlyout = (popover: HTMLElement, event: Event) => {
    const toggleEvent = event as ToggleEvent;
    if (toggleEvent.newState !== "open") return;

    // Clear any prior inline placement first so the mobile bottom-sheet CSS can take over cleanly.
    popover.style.top = "";
    popover.style.left = "";

    if (window.innerWidth <= 640) return;

    const trigger = document.querySelector(`[popovertarget="${popover.id}"]`);
    if (!(trigger instanceof HTMLElement)) return;

    const triggerRect = trigger.getBoundingClientRect();
    const margin = 8;

    popover.style.top = `${triggerRect.bottom + margin}px`;
    popover.style.left = `${triggerRect.left}px`;

    requestAnimationFrame(() => {
      const popoverRect = popover.getBoundingClientRect();
      let top = triggerRect.bottom + margin;
      let left = triggerRect.left;

      if (left + popoverRect.width > window.innerWidth - margin) {
        left = Math.max(margin, window.innerWidth - popoverRect.width - margin);
      }

      if (top + popoverRect.height > window.innerHeight - margin) {
        const above = triggerRect.top - popoverRect.height - margin;
        top = above >= margin ? above : Math.max(margin, window.innerHeight - popoverRect.height - margin);
      }

      popover.style.top = `${top}px`;
      popover.style.left = `${left}px`;
    });
  };

  document.querySelectorAll<HTMLElement>(".signature-flyout").forEach((popover) => {
    popover.addEventListener("beforetoggle", (event) => positionSignatureFlyout(popover, event));
  });

  // A flyout anchored to a trigger's on-screen position stops making sense
  // once the page scrolls out from under it, so dismiss it rather than let
  // it float disconnected from the card that opened it.
  window.addEventListener(
    "scroll",
    () => {
      document
        .querySelectorAll<HTMLElement>(".signature-flyout:popover-open")
        .forEach((popover) => popover.hidePopover());
    },
    { passive: true }
  );
</script>
