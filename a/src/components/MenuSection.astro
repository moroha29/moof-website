---
import { withBase } from "../lib/base.js";

type MenuItem = {
  id: string;
  name: string;
  category: string;
  price: string;
  description: string;
  signature?: string;
  image: string;
  temperatureOptions: string[];
  milkOptions: string[];
  isSeasonal: boolean;
  active: boolean;
};

interface Props {
  title: string;
  description: string;
  items: MenuItem[];
}

const { title, description, items } = Astro.props;
const activeItems = items.filter((item) => item.active);
---

<section class="menu-section" aria-labelledby={`${title.toLowerCase().replaceAll(" ", "-")}-heading`}>
  <div class="section-heading">
    <p>Menu</p>
    <h2 id={`${title.toLowerCase().replaceAll(" ", "-")}-heading`}>{title}</h2>
    <span>{description}</span>
  </div>

  <div class="menu-grid">
    {
      activeItems.map((item) => (
        <article class="menu-card">
          <div class="menu-image">
            <img src={withBase(item.image)} alt="" loading="lazy" />
          </div>
          <div>
            <div class="menu-card-title">
              <h3>{item.name}</h3>
              <strong>{item.price}</strong>
            </div>
            <p>{item.description}</p>
            <div class="menu-tags" aria-label={`${item.name} options`}>
              {item.isSeasonal && <span>seasonal</span>}
              {item.temperatureOptions.map((option) => <span>{option}</span>)}
              {item.milkOptions.map((option) => <span>{option}</span>)}
            </div>
            {item.signature && (
              <>
                <button type="button" class="signature-trigger" data-dialog-target={`signature-section-${item.id}`}>
                  What makes it signature <span aria-hidden="true">＋</span>
                </button>
                <dialog class="signature-dialog" id={`signature-section-${item.id}`}>
                  <div class="signature-dialog-content">
                    <button type="button" class="signature-dialog-close" data-dialog-close aria-label="Close">✕</button>
                    <p class="signature-dialog-label">What makes it signature</p>
                    <h3>{item.name}</h3>
                    <p>{item.signature}</p>
                  </div>
                </dialog>
              </>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest("[data-dialog-target]");
    if (trigger) {
      const dialogId = trigger.getAttribute("data-dialog-target");
      const dialog = dialogId ? document.getElementById(dialogId) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    const closeButton = target.closest("[data-dialog-close]");
    if (closeButton) {
      const dialog = closeButton.closest("dialog");
      if (dialog instanceof HTMLDialogElement) dialog.close();
      return;
    }

    if (target instanceof HTMLDialogElement) {
      target.close();
    }
  });
</script>
