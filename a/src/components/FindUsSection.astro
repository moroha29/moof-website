---
interface Props {
  heading: string;
  body: string;
  address: string;
  unit: string;
  mrtNote: string;
  operatingHours: string;
  instagramLabel: string;
  instagramUrl: string;
}

const { heading, body, address, unit, mrtNote, operatingHours, instagramLabel, instagramUrl } = Astro.props;
---

<section class="find-us-section" id="find-us" aria-labelledby="find-us-heading">
  <div class="section-heading">
    <p>Find us</p>
    <h2 id="find-us-heading">{heading}</h2>
    <span>{body}</span>
  </div>
  <div class="find-us-grid">
    <article>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M12 21s7-6.4 7-12a7 7 0 0 0-14 0c0 5.6 7 12 7 12Z"></path>
        <circle cx="12" cy="9" r="2.4"></circle>
      </svg>
      <span>address</span>
      <h3>{address}</h3>
      <p>{unit}</p>
    </article>
    <article>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M7 4h10a3 3 0 0 1 3 3v7a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V7a3 3 0 0 1 3-3Z"></path>
        <path d="M8 18l-2 3M16 18l2 3M8 8h8M8 13h.01M16 13h.01"></path>
      </svg>
      <span>nearest mrt</span>
      <h3>Tanjong Pagar</h3>
      <p>{mrtNote}</p>
    </article>
    <article>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="8"></circle>
        <path d="M12 7v5l3 2"></path>
      </svg>
      <span>hours</span>
      <h3>operating hours</h3>
      <p>{operatingHours}</p>
    </article>
    <a class="instagram-card" href={instagramUrl} target="_blank" rel="noreferrer">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.2" cy="6.8" r="1"></circle>
      </svg>
      <span>instagram</span>
      <h3>{instagramLabel}</h3>
      <p>Follow Moof for seasonal drinks, bakes, and menu drops.</p>
    </a>
  </div>
</section>
