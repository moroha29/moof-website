---
import { withBase } from "../lib/base.js";

type Ingredient = {
  name: string;
  origin: string;
  description: string;
};

interface Props {
  heading: string;
  body: string;
  storeNote: string;
  image: string;
  ingredients: Ingredient[];
}

const { heading, body, storeNote, image, ingredients } = Astro.props;
---

<section class="about-section" id="about" aria-labelledby="about-heading">
  <div class="section-heading">
    <p>About us</p>
    <h2 id="about-heading">{heading}</h2>
    <span>{storeNote}</span>
  </div>
  <div class="about-card-row">
    <article class="about-story-card">
      <span>story</span>
      <p class="about-body">{body}</p>
    </article>
    <article class="about-image-card">
      <img class="about-image" src={withBase(image)} alt="matcha powder in a bowl with a bamboo whisk" loading="lazy" />
    </article>
    {
      ingredients.map((ingredient) => (
        <article class="ingredient-card">
          <span>{ingredient.origin}</span>
          <h3>{ingredient.name}</h3>
          <p>{ingredient.description}</p>
        </article>
      ))
    }
  </div>
</section>
