---
import { withBase } from "../lib/base.js";

type Ingredient = {
  name: string;
  origin: string;
  description: string;
};

interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  storeNote: string;
  image: string;
  imageAlt: string;
  ingredients: Ingredient[];
}

const { eyebrow, heading, body, storeNote, image, imageAlt, ingredients } = Astro.props;
---

<section class="about-section" id="about" aria-labelledby="about-heading">
  <div class="section-heading">
    <p>{eyebrow}</p>
    <h2 id="about-heading">{heading}</h2>
    <span>{storeNote}</span>
  </div>
  <div class="about-layout">
    <div class="about-copy">
      <p class="about-body">{body}</p>
      <div class="ingredient-strip">
        {
          ingredients.map((ingredient) => (
            <article>
              <span>{ingredient.origin}</span>
              <h3>{ingredient.name}</h3>
              <p>{ingredient.description}</p>
            </article>
          ))
        }
      </div>
    </div>
    <img class="about-image" src={withBase(image)} alt={imageAlt} loading="lazy" />
  </div>
</section>
