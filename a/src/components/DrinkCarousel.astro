---
import { withBase } from "../lib/base.js";
import { getRatingStars } from "../lib/carousel.js";

type Drink = {
  id: string;
  name: string;
  price: string;
  description: string;
  image: string;
  review: {
    quote: string;
    reviewerName: string;
    reviewerImage: string;
  };
  tasting: {
    bitterness: number;
    aroma: number;
    nuttiness: number;
    sweetness: number;
  };
  isSeasonal: boolean;
};

interface Props {
  drinks: Drink[];
  featuredDrinkId: string;
  eyebrow: string;
  headline: string;
  since: string;
  note: string;
}

const { drinks, featuredDrinkId, eyebrow, headline, since, note } = Astro.props;
const featuredDrink = drinks.find((drink) => drink.id === featuredDrinkId) ?? drinks[0];
const tastingLabels = ["bitterness", "aroma", "nuttiness", "sweetness"] as const;
---

<section class="hero-products" aria-label="Featured Moof matcha drinks" data-carousel>
  <div class="hero-copy">
    <p class="hero-eyebrow">{eyebrow}</p>
    <h1>{headline}</h1>
    <div class="hero-meta">
      <span>{since.split(",")[0]}</span>
      <span>{since.split(",")[1]?.trim() ?? "Japan"}</span>
    </div>
  </div>

  <div class="hero-stage">
    <button class="carousel-arrow carousel-arrow-left" type="button" aria-label="Previous drink" data-carousel-arrow="previous">
      <span aria-hidden="true">‹</span>
    </button>
    <aside class="hero-insight hero-review" aria-label="Selected drink review" data-featured-panel>
      <span class="hero-insight-kicker">review</span>
      <p data-review-quote>{featuredDrink.review.quote}</p>
      <div class="reviewer">
        <img src={withBase(featuredDrink.review.reviewerImage)} alt="" loading="lazy" data-reviewer-image />
        <span data-reviewer-name>{featuredDrink.review.reviewerName}</span>
      </div>
    </aside>
    <figure class="featured-drink-panel" aria-live="polite" data-featured-panel>
      <img src={withBase(featuredDrink.image)} alt={featuredDrink.name} class="featured-drink" data-featured-image />
      <figcaption>
        <span data-featured-price>{featuredDrink.price}</span>
        <h2 data-featured-name>{featuredDrink.name}</h2>
        <p data-featured-description>{featuredDrink.description}</p>
      </figcaption>
    </figure>
    <aside class="hero-insight hero-tasting" aria-label="Selected drink tasting profile" data-featured-panel>
      <span class="hero-insight-kicker">tasting</span>
      <div class="tasting-list">
        {
          tastingLabels.map((label) => (
            <div
              class="tasting-row"
              data-tasting-row={label}
              aria-label={`${label}: ${featuredDrink.tasting[label]} out of 5`}
            >
              <span>{label}</span>
              <div class="stars" aria-hidden="true">
                {getRatingStars(featuredDrink.tasting[label]).map((isFilled) => (
                  <span class={isFilled ? "is-filled" : ""}>★</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </aside>
    <button class="carousel-arrow carousel-arrow-right" type="button" aria-label="Next drink" data-carousel-arrow="next">
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <p class="hero-note">{note}</p>

  <div class="drink-rail" aria-label="Choose a Moof drink" role="tablist" data-carousel-rail>
    {
      drinks.map((drink) => (
        <button
          class={`drink-tab ${drink.id === featuredDrink.id ? "is-active" : ""}`}
          type="button"
          role="tab"
          aria-selected={drink.id === featuredDrink.id ? "true" : "false"}
          data-carousel-card
          data-drink-id={drink.id}
          data-drink-name={drink.name}
          data-drink-price={drink.price}
          data-drink-description={drink.description}
          data-drink-image={withBase(drink.image)}
          data-review-quote={drink.review.quote}
          data-reviewer-name={drink.review.reviewerName}
          data-reviewer-image={withBase(drink.review.reviewerImage)}
          data-tasting-bitterness={drink.tasting.bitterness}
          data-tasting-aroma={drink.tasting.aroma}
          data-tasting-nuttiness={drink.tasting.nuttiness}
          data-tasting-sweetness={drink.tasting.sweetness}
        >
          <img src={withBase(drink.image)} alt="" loading="lazy" />
          <span>{drink.name}</span>
          <small>{drink.price}</small>
        </button>
      ))
    }
  </div>

  <script>
    const carousels = document.querySelectorAll("[data-carousel]");

    carousels.forEach((carousel) => {
      const featuredImage = carousel.querySelector("[data-featured-image]");
      const featuredName = carousel.querySelector("[data-featured-name]");
      const featuredPrice = carousel.querySelector("[data-featured-price]");
      const featuredDescription = carousel.querySelector("[data-featured-description]");
      const featuredPanels = carousel.querySelectorAll("[data-featured-panel]");
      const reviewQuote = carousel.querySelector("[data-review-quote]");
      const reviewerName = carousel.querySelector("[data-reviewer-name]");
      const reviewerImage = carousel.querySelector("[data-reviewer-image]");
      const tastingRows = carousel.querySelectorAll("[data-tasting-row]");
      const cards = Array.from(carousel.querySelectorAll("[data-carousel-card]"));
      const arrows = carousel.querySelectorAll("[data-carousel-arrow]");

      const updateFeaturedContent = (card) => {
        if (featuredImage instanceof HTMLImageElement) {
          featuredImage.src = card.dataset.drinkImage ?? "";
          featuredImage.alt = card.dataset.drinkName ?? "";
        }
        if (featuredName) featuredName.textContent = card.dataset.drinkName ?? "";
        if (featuredPrice) featuredPrice.textContent = card.dataset.drinkPrice ?? "";
        if (featuredDescription) featuredDescription.textContent = card.dataset.drinkDescription ?? "";
        if (reviewQuote) reviewQuote.textContent = card.dataset.reviewQuote ?? "";
        if (reviewerName) reviewerName.textContent = card.dataset.reviewerName ?? "";
        if (reviewerImage instanceof HTMLImageElement) {
          reviewerImage.src = card.dataset.reviewerImage ?? "";
        }
        tastingRows.forEach((row) => {
          if (!(row instanceof HTMLElement)) return;
          const ratingKey = row.dataset.tastingRow;
          const rating = Number(card.dataset[`tasting${ratingKey ? ratingKey[0].toUpperCase() + ratingKey.slice(1) : ""}`] ?? 0);
          row.setAttribute("aria-label", `${ratingKey}: ${rating} out of 5`);
          row.querySelectorAll(".stars span").forEach((star, index) => {
            star.classList.toggle("is-filled", index < rating);
          });
        });
      };

      const selectCard = (card, shouldScroll = true) => {
        if (!(card instanceof HTMLElement)) return;
        const currentCard = cards.find((candidate) => candidate.classList.contains("is-active"));
        if (currentCard === card) return;

        cards.forEach((candidate) => {
          const isActive = candidate === card;
          candidate.classList.toggle("is-active", isActive);
          candidate.setAttribute("aria-selected", isActive ? "true" : "false");
        });

        if (featuredPanels.length > 0) {
          featuredPanels.forEach((panel) => panel.classList.add("is-changing"));
          window.setTimeout(() => {
            updateFeaturedContent(card);
            featuredPanels.forEach((panel) => {
              panel.classList.remove("is-changing");
              panel.classList.add("has-returned");
              window.setTimeout(() => panel.classList.remove("has-returned"), 260);
            });
          }, 130);
        } else {
          updateFeaturedContent(card);
        }

        if (shouldScroll) {
          card.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
        }
      };

      cards.forEach((card) => {
        card.addEventListener("click", () => selectCard(card, true));
      });

      arrows.forEach((arrow) => {
        arrow.addEventListener("click", () => {
          const activeIndex = Math.max(0, cards.findIndex((card) => card.classList.contains("is-active")));
          const direction = arrow.getAttribute("data-carousel-arrow");
          const offset = direction === "previous" ? -1 : 1;
          const nextCard = cards[(activeIndex + offset + cards.length) % cards.length];
          selectCard(nextCard, true);
        });
      });

    });
  </script>
</section>
