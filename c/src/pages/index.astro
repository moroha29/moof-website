---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MenuList from "../components/MenuList.astro";
import SeasonalSocialEdit from "../components/SeasonalSocialEdit.astro";
import TeamSection from "../components/TeamSection.astro";
import { withBase } from "../lib/base.js";
import { core, seasonal, testimonials } from "../data/menu.js";
import { site } from "../data/site.js";

const menuPage = withBase("/menu/");
---

<BaseLayout
  title={site.seo.title}
  description={site.seo.description}
>
  <Header active="home" />

  <main>
    <section class="hero">
      <div class="wrap">
        <span class="eyebrow">{site.hero.eyebrow}</span>
        <h1>{site.hero.headline}</h1>
        <p class="lede">{site.hero.supportingCopy}</p>
        <div class="cta-row">
          <a class="btn btn-solid" href={menuPage}>{site.hero.primaryCta}</a>
          <a class="btn btn-outline" href="#visit">{site.hero.secondaryCta}</a>
        </div>
        <div class="hero-image">
          <img src={withBase(site.hero.image)} alt={site.hero.imageAlt} />
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section id="story" class="ritual">
      <div class="wrap">
        <div class="ritual-image">
          <img src={withBase(site.ritual.image)} alt={site.ritual.imageAlt} />
        </div>
        <div class="ritual-copy">
          <span class="eyebrow">{site.ritual.eyebrow}</span>
          <h2>{site.ritual.heading}</h2>
          {site.ritual.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

          <div class="ingredient-pair">
            {
              site.ritual.ingredients.map((ingredient) => (
                <div class="ingredient-card">
                  <h3>{ingredient.name}</h3>
                  <span class="origin">{ingredient.origin}</span>
                  <p>{ingredient.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <section id="menu">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">{site.menuIntro.eyebrow}</span>
          <h2>{site.menuIntro.heading}</h2>
          <p class="sub">{site.menuIntro.supportingCopy}</p>
        </div>

        <MenuList title={site.menuIntro.coreTitle} note={site.menuIntro.coreNote} items={core} />
        <MenuList title={site.menuIntro.seasonalTitle} note={site.menuIntro.seasonalNote} items={seasonal} />

        <div class="menu-cta">
          <a class="btn btn-outline" href={menuPage}>{site.menuIntro.cta}</a>
        </div>
      </div>
    </section>

    <SeasonalSocialEdit />

    <TeamSection />

    <section class="testimonials">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">{site.testimonials.eyebrow}</span>
          <h2>{site.testimonials.heading}</h2>
          <p class="sub">{site.testimonials.supportingCopy}</p>
        </div>
        <div class="testimonial-grid">
          {
            testimonials.map((t) => (
              <div class="testimonial">
                <p class="quote">{t.quote}</p>
                <span class="attribution">{t.name}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="visit" class="visit">
      <div class="wrap">
        <div class="visit-copy">
          <span class="eyebrow">{site.visit.eyebrow}</span>
          <h2>{site.visit.heading}</h2>
          {site.visit.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="visit-details">
          <div class="visit-row">
            <span class="label">Address</span>
            <span class="value">
              {site.visit.addressLines.map((line, index) => <>{line}{index < site.visit.addressLines.length - 1 && <br />}</>)}
            </span>
          </div>
          <div class="visit-row">
            <span class="label">Hours</span>
            <span class="value">
              {site.visit.hoursLines.map((line, index) => <>{line}{index < site.visit.hoursLines.length - 1 && <br />}</>)}
            </span>
          </div>
          <div class="visit-row">
            <span class="label">MRT</span>
            <span class="value">
              {site.visit.mrtLines.map((line, index) => <>{line}{index < site.visit.mrtLines.length - 1 && <br />}</>)}
            </span>
          </div>
          <div class="visit-row">
            <span class="label">Instagram</span>
            <span class="value">
              <a href={site.social.instagramUrl} target="_blank" rel="noreferrer">{site.social.instagramHandle}</a>
            </span>
          </div>
          <p class="visit-note">{site.visit.note}</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
