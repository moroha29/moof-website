---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MenuList from "../components/MenuList.astro";
import { core, seasonal, additionalCategories } from "../data/menu.js";
import { site } from "../data/site.js";
---

<BaseLayout
  title={site.seo.menuTitle}
  description={site.seo.menuDescription}
>
  <Header active="menu" />

  <main>
    <section class="page-hero">
      <div class="wrap">
        <span class="eyebrow">{site.menuPage.eyebrow}</span>
        <h1>{site.menuPage.heading}</h1>
        <p class="sub">{site.menuPage.intro}</p>
      </div>
    </section>

    <hr class="divider" />

    <section>
      <div class="wrap">
        <MenuList title={site.menuIntro.coreTitle} note={site.menuIntro.coreNote} items={core} />
        <MenuList title={site.menuIntro.seasonalTitle} note={site.menuIntro.seasonalNote} items={seasonal} />
        {additionalCategories.map((category) => <MenuList title={category.title} note={category.description} items={category.items} />)}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
