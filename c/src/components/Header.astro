---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";

interface Props {
  active?: "home" | "menu";
}

const { active = "home" } = Astro.props;
const home = withBase("/");
const menuPage = withBase("/menu/");
---

<header class="site-header" aria-label="Primary navigation">
  <a class="wordmark" href={home} aria-label="Moof home">{site.storeName}</a>
  <nav class="desktop-nav">
    <a href={active === "home" ? "#story" : `${home}#story`}>{site.navigation.story}</a>
    <a href={menuPage}>{site.navigation.menu}</a>
    <a href={active === "home" ? "#visit" : `${home}#visit`}>{site.navigation.visit}</a>
    <a href={site.social.instagramUrl} target="_blank" rel="noreferrer">{site.navigation.instagram}</a>
  </nav>
  <details class="mobile-nav">
    <summary aria-label="Open navigation">{site.navigation.mobileToggle}</summary>
    <nav aria-label="Mobile navigation">
      <a href={active === "home" ? "#story" : `${home}#story`}>{site.navigation.story}</a>
      <a href={menuPage}>{site.navigation.menu}</a>
      <a href={active === "home" ? "#visit" : `${home}#visit`}>{site.navigation.visit}</a>
      <a href={site.social.instagramUrl} target="_blank" rel="noreferrer">{site.navigation.instagram}</a>
    </nav>
  </details>
</header>
