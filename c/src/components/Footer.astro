---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";

const home = withBase("/");
const menuPage = withBase("/menu/");
---

<footer>
  <div class="wrap">
    <a class="wordmark" href={home}>{site.storeName}</a>
    <div class="foot-links">
      <a href={menuPage}>Menu</a>
      <a href={site.social.instagramUrl} target="_blank" rel="noreferrer">{site.social.instagramHandle}</a>
      <a href={`${home}#visit`}>Visit</a>
    </div>
    <p class="foot-note">{site.visit.footerNote}</p>
  </div>
</footer>
