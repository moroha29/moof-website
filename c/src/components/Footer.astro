---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";

const home = withBase("/");
const menuPage = withBase("/menu/");
---

<footer>
  <div class="wrap">
    <a class="wordmark" href={home} data-cms-path={JSON.stringify(["homepage", "footer", "wordmark"])}>{site.footer.wordmark}</a>
    <div class="foot-links">
      <a href={menuPage} data-cms-path={JSON.stringify(["homepage", "footer", "menuLabel"])}>{site.footer.menuLabel}</a>
      <a href={site.footer.instagramUrl} target="_blank" rel="noreferrer" data-cms-paths={JSON.stringify([["homepage", "footer", "instagramHandle"], ["homepage", "footer", "instagramUrl"]])}>{site.footer.instagramHandle}</a>
      <a href={`${home}#visit`} data-cms-path={JSON.stringify(["homepage", "footer", "visitLabel"])}>{site.footer.visitLabel}</a>
    </div>
    <p class="foot-note" data-cms-path={JSON.stringify(["homepage", "footer", "note"])}>{site.footer.note}</p>
  </div>
</footer>
