---
import { seasonal } from "../data/menu.js";
import { site } from "../data/site.js";
import { withBase } from "../lib/base.js";
---

<section class="seasonal-edit" aria-labelledby="seasonal-edit-title">
  <div class="wrap">
    <div class="seasonal-edit-intro">
      <span class="eyebrow">{site.seasonalEdit.eyebrow}</span>
      <h2 id="seasonal-edit-title">{site.seasonalEdit.heading}</h2>
      <p>{site.seasonalEdit.supportingCopy}</p>
    </div>

    <div class="seasonal-edit-grid">
      {
        seasonal.map((item, index) => (
          <article class="seasonal-edit-card">
            <span class="seasonal-edit-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div class="seasonal-edit-image">
              <img src={withBase(item.image)} alt={item.name} loading="lazy" />
            </div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>

    <div class="seasonal-edit-social">
      <p>{site.seasonalEdit.socialPrompt}</p>
      <a href={site.social.instagramUrl} target="_blank" rel="noreferrer">
        {site.seasonalEdit.socialCta} {site.social.instagramHandle} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
