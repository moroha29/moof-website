---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";
---

<header class="site-header">
  <a class="logo" href={withBase("/")} aria-label="Moof home">Moof</a>
  <nav aria-label="Primary">
    <a href={withBase("/menu/")}>Menu</a>
    <a
      class="nav-icon-link"
      href={site.instagramUrl}
      target="_blank"
      rel="noreferrer"
      aria-label="Open Moof on Instagram"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.2" cy="6.8" r="1"></circle>
      </svg>
    </a>
  </nav>
  <a class="header-cta" href={site.directionsUrl} target="_blank" rel="noreferrer">
    Get Directions
  </a>
</header>
