---
import { homepage, site } from "../data/site.js";
---

<section class="visit" id="visit" aria-label="Visit Moof">
  <div class="visit-info">
    <p class="eyebrow">{homepage.visit.eyebrow}</p>
    <h2>{homepage.visit.headline}</h2>
    <dl>
      <div>
        <dt>Address</dt>
        <dd>{site.addressLine1}<br />{site.addressLine2}</dd>
      </div>
      <div>
        <dt>Getting there</dt>
        <dd>{site.mrtNote}</dd>
      </div>
      <div>
        <dt>Hours</dt>
        <dd>{site.hours}</dd>
      </div>
    </dl>
    <a class="quiet-link" href={site.directionsUrl} target="_blank" rel="noreferrer">Open in Maps <span aria-hidden="true">→</span></a>
    <div class="visit-map">
      <iframe
        src={site.mapEmbedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Map showing Moof's location"
      ></iframe>
    </div>
  </div>
</section>
