---
import { withBase } from "../lib/base.js";
import { reviews } from "../data/menu.js";
---

<section class="social-proof" aria-label="Customer reviews">
  <p class="social-proof-label">What regulars say</p>
  <div class="review-row">
    {
      reviews.map((review) => (
        <figure class="review-card">
          <blockquote>&ldquo;{review.quote}&rdquo;</blockquote>
          <figcaption>
            {review.image && <img src={withBase(review.image)} alt="" width="32" height="32" loading="lazy" />}
            <span>{review.name}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
