---
import { withBase } from "../lib/base.js";

interface Props {
  item: {
    id?: string;
    name: string;
    price: string;
    description: string;
    image: string;
    tags: string[];
    signature?: string;
  };
}

const { item } = Astro.props;

const slug =
  item.id ??
  item.name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
const dialogId = `signature-flyout-${slug}`;
---

<li class="menu-list-item">
  <img
    src={withBase(item.image)}
    alt={item.name}
    loading="lazy"
    width="112"
    height="112"
  />
  <div class="menu-list-item-body">
    <div class="menu-list-item-top">
      <h3>{item.name}</h3>
      <span class="price">{item.price}</span>
    </div>
    <p>{item.description}</p>
    <span class="tags">{item.tags.join(" · ")}</span>
    {
      item.signature && (
        <>
          <button
            type="button"
            class="signature-trigger"
            popovertarget={dialogId}
          >
            What makes it Moof's
          </button>
          <div id={dialogId} popover class="signature-flyout">
            <button
              type="button"
              class="signature-flyout-close"
              popovertarget={dialogId}
              popovertargetaction="hide"
              aria-label="Close"
            >
              &times;
            </button>
            <h3>{item.name}</h3>
            <p>{item.signature}</p>
          </div>
        </>
      )
    }
  </div>
</li>

<script>
  document.querySelectorAll<HTMLElement>(".signature-flyout").forEach((popoverEl) => {
    popoverEl.addEventListener("beforetoggle", (event) => {
      const toggleEvent = event as ToggleEvent;
      if (toggleEvent.newState !== "open") return;
      if (window.innerWidth <= 640) return;

      const trigger = document.querySelector<HTMLElement>(
        `[popovertarget="${popoverEl.id}"]`
      );
      if (!trigger) return;

      const triggerRect = trigger.getBoundingClientRect();
      const popoverRect = popoverEl.getBoundingClientRect();
      const margin = 8;

      let top = triggerRect.bottom + margin;
      let left = triggerRect.left;

      if (top + popoverRect.height > window.innerHeight) {
        top = triggerRect.top - popoverRect.height - margin;
      }
      if (top < margin) top = margin;

      if (left + popoverRect.width > window.innerWidth) {
        left = window.innerWidth - popoverRect.width - margin;
      }
      if (left < margin) left = margin;

      popoverEl.style.top = `${top}px`;
      popoverEl.style.left = `${left}px`;
    });
  });

  // A flyout anchored to a trigger's on-screen position stops making sense
  // once the page scrolls out from under it, so dismiss it rather than let
  // it float disconnected from the item that opened it.
  window.addEventListener(
    "scroll",
    () => {
      document
        .querySelectorAll<HTMLElement>(".signature-flyout:popover-open")
        .forEach((popoverEl) => popoverEl.hidePopover());
    },
    { passive: true }
  );
</script>
