---
import { withBase } from "../lib/base.js";

interface Props {
  item: {
    name: string;
    price: string;
    description: string;
    image: string;
    tags: string[];
    signature?: string;
  };
}

const { item } = Astro.props;
---

<li class="menu-list-item">
  <img
    src={withBase(item.image)}
    alt={item.name}
    loading="lazy"
    width="112"
    height="112"
  />
  <div class="menu-list-item-body">
    <div class="menu-list-item-top">
      <h3>{item.name}</h3>
      <span class="price">{item.price}</span>
    </div>
    <p>{item.description}</p>
    <span class="tags">{item.tags.join(" · ")}</span>
    {
      item.signature && (
        <details class="menu-signature">
          <summary>What makes it Moof's</summary>
          <p>{item.signature}</p>
        </details>
      )
    }
  </div>
</li>
