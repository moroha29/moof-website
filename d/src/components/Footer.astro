---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="logo" href={withBase("/")} data-cms-path={JSON.stringify(["homepage", "site", "footer", "wordmark"])}>{site.footer.wordmark}</a>
    <p data-cms-paths={JSON.stringify([["homepage", "site", "footer", "addressLine1"], ["homepage", "site", "footer", "addressLine2"], ["homepage", "site", "footer", "hours"]])}>{site.footer.addressLine1}, {site.footer.addressLine2} · {site.footer.hours}</p>
    <a href={site.footer.instagramUrl} target="_blank" rel="noreferrer" data-cms-paths={JSON.stringify([["homepage", "site", "footer", "instagramHandle"], ["homepage", "site", "footer", "instagramUrl"]])}>{site.footer.instagramHandle}</a>
  </div>
</footer>
