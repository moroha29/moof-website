---
import { withBase } from "../lib/base.js";
import { homepage } from "../data/site.js";
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{homepage.hero.eyebrow}</p>
    <h1>{homepage.hero.headline}</h1>
    <p class="hero-sub">{homepage.hero.supportingCopy}</p>
  </div>
  <div class="hero-art">
    <img
      src={withBase(homepage.hero.image)}
      alt={homepage.hero.imageAlt}
      class="hero-drink"
      loading="eager"
      fetchpriority="high"
      width="560"
      height="560"
    />
  </div>
</section>
