---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">Specialty Matcha &amp; Hojicha Bar · Tanjong Pagar</p>
    <h1>Real ceremonial-grade matcha, 5 minutes from your desk.</h1>
    <p class="hero-sub">
      Hand-whisked with exclusive Japanese matcha — Mori and Shiran — plus a rotating seasonal menu.
      No sign-up, no queue app. Just walk in.
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href={site.directionsUrl} target="_blank" rel="noreferrer">
        Get Directions
      </a>
      <a class="btn btn-ghost" href={withBase("/menu/")}>See Today's Menu</a>
    </div>

    <ul class="hero-facts" aria-label="Visit details">
      <li><span aria-hidden="true">📍</span> {site.addressLine1}, {site.addressLine2}</li>
      <li><span aria-hidden="true">🚶</span> {site.mrtNote}</li>
      <li><span aria-hidden="true">🕘</span> {site.hours}</li>
    </ul>
  </div>

  <div class="hero-art" aria-hidden="true">
    <div class="hero-blob"></div>
    <img
      src={withBase("/images/specialty-matcha-latte-cutout.png")}
      alt=""
      class="hero-drink hero-drink-1"
      loading="eager"
      fetchpriority="high"
      width="420"
      height="420"
    />
    <img
      src={withBase("/images/strawberry-royal-matcha-cutout.png")}
      alt=""
      class="hero-drink hero-drink-2"
      loading="eager"
      width="220"
      height="220"
    />
    <span class="hero-badge">Seasonal drinks pouring now</span>
  </div>
</section>
