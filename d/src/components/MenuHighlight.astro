---
import MenuRow from "./MenuRow.astro";
import { withBase } from "../lib/base.js";
import { coreItems } from "../data/menu.js";
import { homepage, ingredients } from "../data/site.js";
---

<section class="menu-highlight" aria-label="Core menu">
  <div class="menu-highlight-heading">
    <p class="eyebrow">{homepage.menuHighlight.eyebrow}</p>
    <h2>{homepage.menuHighlight.headline}</h2>
    <p>
      {homepage.menuHighlight.supportingLead} —
      {ingredients.map((ing, i) => (
        <>
          <strong>{ing.name}</strong>{i < ingredients.length - 1 ? ", " : "."}
        </>
      ))}
    </p>
  </div>

  <ul class="core-list">
    {
      coreItems.map((item) => <MenuRow item={item} variant="core" />)
    }
  </ul>

  <a class="text-link" href={withBase("/menu/")}>{homepage.menuHighlight.cta}</a>
</section>
