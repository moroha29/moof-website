---
import { withBase } from "../lib/base.js";
import { coreItems } from "../data/menu.js";
import { homepage } from "../data/site.js";

const featuredItems = coreItems.slice(0, 3);
---

<section class="featured-drinks" aria-labelledby="featured-heading">
  <div class="section-heading">
    <p class="eyebrow">{homepage.featured.eyebrow}</p>
    <h2 id="featured-heading">{homepage.featured.headline}</h2>
  </div>
  <ul class="featured-list">
    {
      featuredItems.map((item) => {
        const slug =
          item.id ??
          item.name
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/^-+|-+$/g, "");
        const dialogId = `featured-signature-flyout-${slug}`;

        return (
          <li>
            <img src={withBase(item.image)} alt={item.name} loading="lazy" width="320" height="320" />
            <div>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              <span>{item.price}</span>
              {
                item.signature && (
                  <>
                    <button
                      type="button"
                      class="signature-trigger"
                      popovertarget={dialogId}
                    >
                      What makes it Moof's
                    </button>
                    <div id={dialogId} popover class="signature-flyout">
                      <button
                        type="button"
                        class="signature-flyout-close"
                        popovertarget={dialogId}
                        popovertargetaction="hide"
                        aria-label="Close"
                      >
                        &times;
                      </button>
                      <h3>{item.name}</h3>
                      <p>{item.signature}</p>
                    </div>
                  </>
                )
              }
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".signature-flyout").forEach((popoverEl) => {
    popoverEl.addEventListener("beforetoggle", (event) => {
      const toggleEvent = event as ToggleEvent;
      if (toggleEvent.newState !== "open") return;
      if (window.innerWidth <= 640) return;

      const trigger = document.querySelector<HTMLElement>(
        `[popovertarget="${popoverEl.id}"]`
      );
      if (!trigger) return;

      const triggerRect = trigger.getBoundingClientRect();
      const popoverRect = popoverEl.getBoundingClientRect();
      const margin = 8;

      let top = triggerRect.bottom + margin;
      let left = triggerRect.left;

      if (top + popoverRect.height > window.innerHeight) {
        top = triggerRect.top - popoverRect.height - margin;
      }
      if (top < margin) top = margin;

      if (left + popoverRect.width > window.innerWidth) {
        left = window.innerWidth - popoverRect.width - margin;
      }
      if (left < margin) left = margin;

      popoverEl.style.top = `${top}px`;
      popoverEl.style.left = `${left}px`;
    });
  });
</script>
