---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import StorySection from "../components/StorySection.astro";
import FeaturedDrinks from "../components/FeaturedDrinks.astro";
import MenuPreview from "../components/MenuPreview.astro";
import TeamSection from "../components/TeamSection.astro";
import VisitSection from "../components/VisitSection.astro";
import { site } from "../data/site.js";
---

<BaseLayout
  title={site.seo.homeTitle}
  description={site.seo.homeDescription}
>
  <main class="page-home">
    <Hero />
    <StorySection />
    <FeaturedDrinks />
    <MenuPreview />
    <TeamSection />
    <VisitSection />
  </main>
</BaseLayout>
