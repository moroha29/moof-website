---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuRow from "../components/MenuRow.astro";
import { coreItems, seasonalItems } from "../data/menu.js";
import { menuPage, site } from "../data/site.js";

const menuItems = [...coreItems, ...seasonalItems];
---

<BaseLayout
  title={site.seo.menuTitle}
  description={site.seo.menuDescription}
>
  <main class="page-menu">
    <div class="menu-page-heading">
      <p class="eyebrow">{menuPage.eyebrow}</p>
      <h1>{menuPage.headline}</h1>
      <p class="menu-page-sub">
        {menuPage.introPrefix} {site.hours} - {site.mrtNote}.
      </p>
    </div>

    <section aria-label="Moof drinks" class="menu-list-section">
      <ul class="menu-list">
        {
          menuItems.map((item) => <MenuRow item={item} />)
        }
      </ul>
    </section>

    <p class="menu-page-footer">{site.addressLine1}, {site.addressLine2} - {site.mrtNote}</p>
  </main>
</BaseLayout>
