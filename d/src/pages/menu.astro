---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuRow from "../components/MenuRow.astro";
import { coreItems, seasonalItems } from "../data/menu.js";
import { site } from "../data/site.js";

const menuItems = [...coreItems, ...seasonalItems];
---

<BaseLayout
  title="Menu — Moof Matcha & Hojicha, Tanjong Pagar"
  description="Full Moof menu: matcha, hojicha, and seasonal drinks at Eon Shenton in Tanjong Pagar."
>
  <main class="page-menu">
    <div class="menu-page-heading">
      <p class="eyebrow">Menu</p>
      <h1>Matcha, hojicha, and more.</h1>
      <p class="menu-page-sub">
        Fresh or oat milk on request. {site.hours} · {site.mrtNote}.
      </p>
    </div>

    <section aria-label="Moof drinks" class="menu-list-section">
      <ul class="menu-list">
        {
          menuItems.map((item) => <MenuRow item={item} />)
        }
      </ul>
    </section>

    <p class="menu-page-footer">{site.addressLine1}, {site.addressLine2} · {site.mrtNote}</p>
  </main>
</BaseLayout>
