---
import site from "../assets/content/site.json";
import menu from "../assets/content/menu.json";
import { withBase } from "../lib/base.js";
const drinks = [...menu.coreMenu, ...menu.seasonalMenu].filter((item) => item.active);
const p = (path) => JSON.stringify(path);
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={site.seo.homeDescription} /><title>{site.seo.homeTitle}</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" /><link rel="stylesheet" href={withBase("styles.css")} /></head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="rail">
    <a class="logo" href="#top" aria-label="Moof home"><span data-cms-path={p(["homepage","brand","headerWordmark"])}>{site.brand.headerWordmark}</span><b aria-hidden="true">●</b></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="side-nav"><span class="open-label" data-cms-path={p(["homepage","navigation","menuToggleLabel"])}>{site.navigation.menuToggleLabel}</span><span class="close-label" data-cms-path={p(["homepage","navigation","closeLabel"])}>{site.navigation.closeLabel}</span><i aria-hidden="true"></i></button>
    <nav id="side-nav" aria-label="Section navigation" aria-hidden="true" inert>
      <a href="#about"><span>01</span><b data-cms-path={p(["homepage","navigation","aboutLabel"])}>{site.navigation.aboutLabel}</b></a>
      <a href="#menu"><span>02</span><b data-cms-path={p(["homepage","navigation","menuLabel"])}>{site.navigation.menuLabel}</b></a>
      <a href="#story"><span>03</span><b data-cms-path={p(["homepage","navigation","storyLabel"])}>{site.navigation.storyLabel}</b></a>
      <a href="#events"><span>04</span><b data-cms-path={p(["homepage","navigation","eventsLabel"])}>{site.navigation.eventsLabel}</b></a>
      <a href="#visit"><span>05</span><b data-cms-path={p(["homepage","navigation","visitLabel"])}>{site.navigation.visitLabel}</b></a>
      <a href="#business"><span>06</span><b data-cms-path={p(["homepage","navigation","businessLabel"])}>{site.navigation.businessLabel}</b></a>
    </nav>
  </header>
  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-heading">
      <img src={withBase(site.hero.image)} alt={site.hero.imageAlt} data-cms-paths={p([["homepage","hero","image"],["homepage","hero","imageAlt"]])} />
      <div class="hero-shade"></div><div class="hero-copy"><p class="eyebrow light" data-cms-path={p(["homepage","hero","eyebrow"])}>{site.hero.eyebrow}</p><h1 id="hero-heading" data-cms-path={p(["homepage","hero","headline"])}>{site.hero.headline}</h1><p class="lead" data-cms-path={p(["homepage","hero","supportingCopy"])}>{site.hero.supportingCopy}</p></div>
      <p class="announcement"><span data-cms-path={p(["homepage","hero","announcement"])}>{site.hero.announcement}</span></p><a class="scroll" href="#about" aria-label="Scroll to About us">↓</a>
    </section>

    <section class="about split" id="about" aria-labelledby="about-heading"><div class="copy"><p class="eyebrow" data-cms-path={p(["homepage","about","eyebrow"])}>{site.about.eyebrow}</p><h2 id="about-heading" data-cms-path={p(["homepage","about","heading"])}>{site.about.heading}</h2><p data-cms-path={p(["homepage","about","body"])}>{site.about.body}</p></div><figure><img src={withBase(site.about.image)} alt={site.about.imageAlt} loading="lazy" data-cms-paths={p([["homepage","about","image"],["homepage","about","imageAlt"]])} /></figure></section>

    <section class="menu" id="menu" aria-labelledby="menu-heading"><header><div><p class="eyebrow" data-cms-path={p(["homepage","menuSection","eyebrow"])}>{site.menuSection.eyebrow}</p><h2 id="menu-heading" data-cms-path={p(["homepage","menuSection","heading"])}>{site.menuSection.heading}</h2></div><p data-cms-path={p(["homepage","menuSection","intro"])}>{site.menuSection.intro}</p></header><div class="carousel-controls"><button type="button" data-prev aria-label={site.menuSection.previousLabel}>←</button><button type="button" data-next aria-label={site.menuSection.nextLabel}>→</button></div><div class="drink-track" tabindex="0" aria-label="Featured menu drinks">
      {drinks.map((item, index) => { const groupIndex = index < menu.coreMenu.filter(i=>i.active).length ? 0 : 1; const itemIndex = groupIndex === 0 ? menu.coreMenu.indexOf(item) : menu.seasonalMenu.indexOf(item); const base=["menuGroups",groupIndex,"items",itemIndex]; return <article class="drink-card"><div class="drink-image"><img src={withBase(item.image)} alt={item.imageAlt} loading="lazy" data-cms-paths={p([[...base,"image"],[...base,"imageAlt"]])} /></div><div class="drink-meta"><span class="drink-count" aria-hidden="true">0{index+1}</span><h3 data-cms-path={p([...base,"name"])}>{item.name}</h3><strong data-cms-path={p([...base,"price"])}>{item.price}</strong><p data-cms-path={p([...base,"description"])}>{item.description}</p></div></article> })}
    </div><a class="text-link" href={withBase("menu/")}><span data-cms-path={p(["homepage","menuSection","fullMenuLabel"])}>{site.menuSection.fullMenuLabel}</span> ↗</a></section>

    <section class="story" id="story" aria-labelledby="story-heading"><p class="eyebrow light" data-cms-path={p(["homepage","story","eyebrow"])}>{site.story.eyebrow}</p><h2 id="story-heading" data-cms-path={p(["homepage","story","heading"])}>{site.story.heading}</h2><div><p data-cms-path={p(["homepage","story","body"])}>{site.story.body}</p><blockquote data-cms-path={p(["homepage","story","note"])}>{site.story.note}</blockquote></div></section>

    <section class="events" id="events" aria-labelledby="events-heading"><img src={withBase(site.events.image)} alt={site.events.imageAlt} loading="lazy" data-cms-paths={p([["homepage","events","image"],["homepage","events","imageAlt"]])} /><div class="event-card"><p class="eyebrow light" data-cms-path={p(["homepage","events","eyebrow"])}>{site.events.eyebrow}</p><h2 id="events-heading" data-cms-path={p(["homepage","events","heading"])}>{site.events.heading}</h2><p data-cms-path={p(["homepage","events","body"])}>{site.events.body}</p><a href={site.events.ctaUrl} data-cms-paths={p([["homepage","events","ctaUrl"]])}><span data-cms-path={p(["homepage","events","ctaLabel"])}>{site.events.ctaLabel}</span> →</a></div></section>

    <section class="visit split" id="visit" aria-labelledby="visit-heading"><div class="copy"><p class="eyebrow" data-cms-path={p(["homepage","visit","eyebrow"])}>{site.visit.eyebrow}</p><h2 id="visit-heading" data-cms-path={p(["homepage","visit","heading"])}>{site.visit.heading}</h2><p data-cms-path={p(["homepage","visit","body"])}>{site.visit.body}</p><address><strong data-cms-path={p(["homepage","visit","address"])}>{site.visit.address}</strong><span data-cms-path={p(["homepage","visit","unit"])}>{site.visit.unit}</span></address><dl><dt data-cms-path={p(["homepage","visit","hoursLabel"])}>{site.visit.hoursLabel}</dt><dd data-cms-path={p(["homepage","visit","hours"])}>{site.visit.hours}</dd></dl><a class="text-link" href={site.visit.mapUrl} data-cms-paths={p([["homepage","visit","mapUrl"]])}><span data-cms-path={p(["homepage","visit","mapLabel"])}>{site.visit.mapLabel}</span> ↗</a></div><iframe src={site.visit.mapEmbedUrl} title="Map showing the Moof cafe location" loading="lazy" data-cms-paths={p([["homepage","visit","mapEmbedUrl"]])}></iframe></section>

    <section class="business" id="business" aria-labelledby="business-heading"><p class="eyebrow light" data-cms-path={p(["homepage","business","eyebrow"])}>{site.business.eyebrow}</p><h2 id="business-heading" data-cms-path={p(["homepage","business","heading"])}>{site.business.heading}</h2><p data-cms-path={p(["homepage","business","body"])}>{site.business.body}</p><div class="business-links"><a href={site.business.emailUrl} data-cms-paths={p([["homepage","business","emailUrl"]])}><span data-cms-path={p(["homepage","business","emailLabel"])}>{site.business.emailLabel}</span></a><a href={site.business.instagramUrl} data-cms-paths={p([["homepage","business","instagramUrl"]])}><span data-cms-path={p(["homepage","business","instagramLabel"])}>{site.business.instagramLabel}</span></a></div></section>
  </main>
  <footer><strong data-cms-path={p(["homepage","brand","footerWordmark"])}>{site.brand.footerWordmark}</strong><span data-cms-path={p(["homepage","footer","copyright"])}>{site.footer.copyright}</span><a href="#top" data-cms-path={p(["homepage","footer","backToTopLabel"])}>{site.footer.backToTopLabel} ↑</a></footer>
  <script is:inline>const toggle=document.querySelector('.menu-toggle'),nav=document.querySelector('#side-nav');const setMenu=open=>{toggle.setAttribute('aria-expanded',String(open));nav.classList.toggle('open',open);nav.setAttribute('aria-hidden',String(!open));nav.toggleAttribute('inert',!open);document.body.classList.toggle('menu-open',open)};toggle?.addEventListener('click',()=>setMenu(toggle.getAttribute('aria-expanded')!=='true'));nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>setMenu(false)));document.addEventListener('keydown',event=>{if(event.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){setMenu(false);toggle.focus()}});const track=document.querySelector('.drink-track');document.querySelector('[data-next]')?.addEventListener('click',()=>track.scrollBy({left:track.clientWidth*.72,behavior:'smooth'}));document.querySelector('[data-prev]')?.addEventListener('click',()=>track.scrollBy({left:-track.clientWidth*.72,behavior:'smooth'}));</script>
</body></html>
