---
import site from "../../assets/content/site.json";
import menu from "../../assets/content/menu.json";
import { withBase } from "../../lib/base.js";
const groups=[{title:site.menuPage.coreTitle,description:site.menuPage.coreDescription,items:menu.coreMenu},{title:site.menuPage.seasonalTitle,description:site.menuPage.seasonalDescription,items:menu.seasonalMenu},...menu.additionalCategories];
const p=(path)=>JSON.stringify(path);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={site.seo.menuDescription}/><title>{site.seo.menuTitle}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet"/><link rel="stylesheet" href={withBase("styles.css")}/><style>.full-menu{margin-left:96px;padding:8rem clamp(2rem,8vw,8rem);min-height:100vh}.menu-top{display:flex;justify-content:space-between;align-items:start}.menu-brand{display:flex;align-items:center;gap:.75rem;text-decoration:none}.menu-brand img{width:58px;height:58px;border-radius:50%;object-fit:cover}.menu-top a{text-underline-offset:.35rem}.full-menu h1{font:700 clamp(4rem,9vw,9rem)/.9 "Fraunces",serif;letter-spacing:-.06em;max-width:1000px;margin:0 0 2rem}.menu-intro{font-size:1.2rem;line-height:1.6;max-width:620px}.full-group{margin-top:7rem}.group-head{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line);padding-bottom:1rem}.group-head h2{font:600 clamp(2.4rem,5vw,5rem) "Fraunces",serif;margin:0}.full-item{display:grid;grid-template-columns:130px 1fr auto;gap:2rem;align-items:center;padding:2rem 0;border-bottom:1px solid var(--line)}.full-item img{width:130px;height:130px;object-fit:contain;background:var(--orange)}.full-item h3{font:600 1.5rem "Fraunces",serif;margin:0 0 .5rem}.full-item p{margin:0;line-height:1.5}.full-item strong{font-size:1.2rem}@media(max-width:760px){.full-menu{margin-left:0;padding:7rem 1.5rem 4rem}.group-head{grid-template-columns:1fr}.full-item{grid-template-columns:86px 1fr auto;gap:1rem}.full-item img{width:86px;height:100px}.full-item p{grid-column:2/4}.menu-top{display:block}.menu-top a{display:inline-flex;margin-bottom:3rem}.menu-brand img{width:48px;height:48px}}</style></head><body><main class="full-menu"><div class="menu-top"><a class="menu-brand" href={withBase("")} aria-label="Back to Moof home">← <img src={withBase(site.brand.logoImage)} alt={site.brand.logoImageAlt} data-cms-paths={p([["homepage","brand","logoImage"],["homepage","brand","logoImageAlt"]])}/></a><div><p class="eyebrow" data-cms-path={p(["homepage","menuPage","eyebrow"])}>{site.menuPage.eyebrow}</p><h1 data-cms-path={p(["homepage","menuPage","heading"])}>{site.menuPage.heading}</h1><p class="menu-intro" data-cms-path={p(["homepage","menuPage","intro"])}>{site.menuPage.intro}</p></div></div>{groups.map((group,groupIndex)=><section class="full-group"><header class="group-head"><h2 data-cms-path={p(["menuGroups",groupIndex,"title"])}>{group.title}</h2><p data-cms-path={p(["menuGroups",groupIndex,"description"])}>{group.description}</p></header>{group.items.filter(i=>i.active).map((item,itemIndex)=>{const base=["menuGroups",groupIndex,"items",itemIndex];return <article class="full-item"><img src={withBase(item.image)} alt={item.imageAlt} data-cms-paths={p([[...base,"image"],[...base,"imageAlt"]])}/><div><h3 data-cms-path={p([...base,"name"])}>{item.name}</h3><p data-cms-path={p([...base,"description"])}>{item.description}</p></div><strong data-cms-path={p([...base,"price"])}>{item.price}</strong></article>})}</section>)}</main></body></html>
