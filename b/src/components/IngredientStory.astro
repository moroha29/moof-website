---
import { site } from "../data/site.js";
---

<section id="origin" class="section ingredients">
  <div class="wrap">
    <div class="section-intro">
      <p class="eyebrow">{site.ingredients.eyebrow}</p>
      <h2>{site.ingredients.heading}</h2>
      <p>{site.ingredients.intro}</p>
    </div>
    <div class="ingredient-grid">
      {
        site.ingredients.items.map((ingredient) => (
          <article class="ingredient-card">
            <p class="ingredient-origin">Source · {ingredient.origin}</p>
            <h3>{ingredient.name}</h3>
            <p class="ingredient-label">{ingredient.label}</p>
            <p>{ingredient.description}</p>
          </article>
        ))
      }
    </div>
    <div class="ritual" aria-label={site.ingredients.ritual.label}>
      <p class="ritual-label">{site.ingredients.ritual.label}</p>
      <ol>
        {site.ingredients.ritual.steps.map((step, index) => <li><span>0{index + 1}</span>{step}</li>)}
      </ol>
    </div>
  </div>
</section>
