---
import { site } from "../data/site.js";
---

<section id="origin" class="section origin">
  <div class="wrap">
    <span class="section-tag">{site.ingredients.eyebrow}</span>
    <div class="section-heading">
      <h2>{site.ingredients.heading}</h2>
      <p>{site.ingredients.intro}</p>
    </div>
    <div class="origin-grid">
      {
        site.ingredients.items.map((ingredient, index) => (
          <div class="origin-card">
            <span class={`badge ${index === 0 ? "badge-pink" : "badge-sky"} origin-stamp`}>
              {ingredient.origin}
            </span>
            <p class="origin-name"><span class="origin-flag">{ingredient.icon}</span> {ingredient.name}</p>
            <p class="origin-tagline">{ingredient.tagline}</p>
            <p class="origin-body">{ingredient.description}</p>
          </div>
        ))
      }
    </div>
    <div class="origin-note">
      <span>🫡</span>
      <span>{site.ingredients.note}</span>
    </div>
  </div>
</section>
