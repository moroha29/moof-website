---
import { site } from "../data/site.js";
---

<section id="find-us" class="section visit">
  <div class="wrap visit-grid">
    <div class="section-intro">
      <p class="eyebrow">{site.findUs.eyebrow}</p>
      <h2>{site.findUs.heading}</h2>
      <p>{site.findUs.intro}</p>
    </div>
    <div class="visit-details">
      <div>
        <h3>{site.findUs.addressLabel}</h3>
        <p>{site.findUs.addressLines[0]}<br />{site.findUs.addressLines[1]}</p>
      </div>
      <div>
        <h3>{site.findUs.directionsLabel}</h3>
        <p>{site.findUs.mrtNote}</p>
      </div>
      <div>
        <h3>{site.findUs.hoursLabel}</h3>
        <p>{site.findUs.operatingDays}<br />{site.findUs.operatingHours}</p>
      </div>
    </div>
  </div>
</section>
