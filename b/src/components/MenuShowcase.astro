---
import { coreMenu } from "../data/menu.js";
import { site } from "../data/site.js";
import { withBase } from "../lib/base.js";
import DrinkCard from "./DrinkCard.astro";
---

<section id="menu" class="section menu-showcase">
  <div class="wrap">
    <div class="section-intro menu-intro">
      <p class="eyebrow">{site.menuShowcase.eyebrow}</p>
      <h2>{site.menuShowcase.heading}</h2>
      <p>{site.menuShowcase.intro}</p>
    </div>
    <div class="choice-grid">
      {coreMenu.slice(0, 3).map((item) => <DrinkCard {...item} />)}
    </div>
    <aside class="menu-preview">
      <div>
        <p class="eyebrow">{site.menuShowcase.previewEyebrow}</p>
        <h3>{site.menuShowcase.previewHeading}</h3>
      </div>
      <p>{site.menuShowcase.previewBody}</p>
      <a class="button button-secondary" href={withBase("menu")}>{site.menuShowcase.menuCta} <span aria-hidden="true">→</span></a>
    </aside>
  </div>
</section>
