---
import { coreMenu, seasonalMenu } from "../data/menu.js";
import { withBase } from "../lib/base.js";
import DrinkCard from "./DrinkCard.astro";
---

<section id="menu" class="section menu-block">
  <div class="wrap">
    <span class="section-tag">The regulars</span>
    <div class="section-heading">
      <h2>The core lineup</h2>
      <p>Always on the board, every single day we're open. These are the ones people build routines around.</p>
    </div>
    <div class="menu-grid">
      {coreMenu.map((item) => <DrinkCard {...item} />)}
    </div>
  </div>
</section>

<section class="section menu-block alt">
  <div class="wrap">
    <span class="section-tag">Limited run</span>
    <div class="section-heading">
      <h2>Seasonal drops</h2>
      <p>The current rotation. Come back often &mdash; these don't stick around forever.</p>
    </div>
    <div class="menu-grid">
      {seasonalMenu.map((item) => <DrinkCard {...item} />)}
    </div>
    <div class="menu-cta">
      <a class="btn btn-matcha" href={withBase("menu")}>View full menu &amp; prices &rarr;</a>
    </div>
  </div>
</section>
