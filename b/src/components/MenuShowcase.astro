---
import { coreMenu, seasonalMenu } from "../data/menu.js";
import { site } from "../data/site.js";
import { withBase } from "../lib/base.js";
import DrinkCard from "./DrinkCard.astro";
---

<section id="menu" class="section menu-block">
  <div class="wrap">
    <span class="section-tag">{site.menuShowcase.coreEyebrow}</span>
    <div class="section-heading">
      <h2>{site.menuShowcase.coreHeading}</h2>
      <p>{site.menuShowcase.coreIntro}</p>
    </div>
    <div class="menu-grid">
      {coreMenu.map((item) => <DrinkCard {...item} />)}
    </div>
  </div>
</section>

<section class="section menu-block alt">
  <div class="wrap">
    <span class="section-tag">{site.menuShowcase.seasonalEyebrow}</span>
    <div class="section-heading">
      <h2>{site.menuShowcase.seasonalHeading}</h2>
      <p>{site.menuShowcase.seasonalIntro}</p>
    </div>
    <div class="menu-grid">
      {seasonalMenu.map((item) => <DrinkCard {...item} />)}
    </div>
    <div class="menu-cta">
      <a class="btn btn-matcha" href={withBase("menu")}>{site.menuShowcase.menuCta}</a>
    </div>
  </div>
</section>
