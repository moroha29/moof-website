---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";

const targetUrls = {
  home: withBase("/"),
  menu: withBase("menu"),
  origin: `${withBase("/")}#origin`,
  "find-us": `${withBase("/")}#find-us`
};
const links = site.navigation.map((link) => ({ ...link, href: targetUrls[link.target] }));
---

<header class="site-header" aria-label="Primary navigation">
  <a class="logo" href={withBase("")} aria-label="Moof home">
    <span class="dot" aria-hidden="true"></span>
    {site.storeName}
  </a>
  <nav class="site-nav">
    {
      links.map((link) => (
        <a href={link.href}>
          <span class="nav-label">{link.label}</span>
        </a>
      ))
    }
    <a
      class="nav-icon-link"
      href={site.instagram.url}
      target="_blank"
      rel="noreferrer"
      aria-label="Stalk Moof on Instagram"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.2" cy="6.8" r="1"></circle>
      </svg>
    </a>
  </nav>
  <details class="mobile-nav">
    <summary aria-label="Open navigation">
      <span>Menu</span>
      <span aria-hidden="true">☰</span>
    </summary>
    <nav aria-label="Mobile navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={site.instagram.url} target="_blank" rel="noreferrer">
        Instagram
      </a>
    </nav>
  </details>
</header>
