---
import { withBase } from "../lib/base.js";

interface Props {
  id: string;
  name: string;
  price: string;
  tag: string;
  blurb: string;
  temp: string;
  milk: string;
  image: string;
  signature?: string;
}

const { id, name, price, tag, blurb, temp, milk, image, signature } = Astro.props;
const dialogId = `signature-${id}`;
---

<article class="drink-card">
  <div class="drink-media">
    <img src={withBase(image)} alt={name} loading="lazy" />
  </div>
  <div class="drink-content">
    <div class="drink-heading">
      <div>
        <p class="drink-tag">{tag}</p>
        <h3>{name}</h3>
      </div>
      <span class="drink-price">{price}</span>
    </div>
    <p class="drink-blurb">{blurb}</p>
    <dl class="drink-meta">
      <div><dt>Serve</dt><dd>{temp}</dd></div>
      <div><dt>Choice</dt><dd>{milk}</dd></div>
    </dl>
    {signature && (
      <>
        <button
          type="button"
          class="drink-signature-trigger"
          data-dialog-target={dialogId}
          aria-haspopup="dialog"
        >
          What makes it this drink
        </button>
        <dialog class="drink-signature-dialog" id={dialogId}>
          <div class="drink-signature-panel">
            <button type="button" class="drink-signature-close" data-dialog-close aria-label="Close">
              &times;
            </button>
            <p class="drink-signature-eyebrow">What makes it this drink</p>
            <h4>{name}</h4>
            <p class="drink-signature-copy">{signature}</p>
          </div>
        </dialog>
      </>
    )}
  </div>
</article>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const trigger = target.closest<HTMLElement>("[data-dialog-target]");
    if (trigger) {
      const dialogId = trigger.dataset.dialogTarget;
      const dialog = dialogId ? document.getElementById(dialogId) : null;
      if (dialog instanceof HTMLDialogElement) {
        dialog.showModal();
      }
      return;
    }

    const closeButton = target.closest<HTMLElement>("[data-dialog-close]");
    if (closeButton) {
      const dialog = closeButton.closest("dialog");
      dialog?.close();
      return;
    }

    if (target instanceof HTMLDialogElement) {
      target.close();
    }
  });
</script>
