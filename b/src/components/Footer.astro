---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";
---

<footer class="site-footer">
  <div class="wrap">
    <p class="foot-logo">{site.storeName}</p>
    <p>
      {site.findUs.addressLines.join(", ")} &middot; {site.findUs.operatingDays}, {site.findUs.operatingHours}
    </p>
    <p>
      <a href={site.instagram.url} target="_blank" rel="noreferrer">{site.instagram.handle}</a>
      &middot;
      <a href={withBase("menu")}>Menu</a>
    </p>
  </div>
</footer>
