---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <p class="foot-logo" data-cms-path={JSON.stringify(["homepage", "footer", "wordmark"])}>{site.footer.wordmark}<span aria-hidden="true">.</span></p>
    <p data-cms-path={JSON.stringify(["homepage", "footer", "address"])}>{site.footer.address}</p>
    <p data-cms-path={JSON.stringify(["homepage", "footer", "hours"])}>{site.footer.hours}</p>
    <div class="footer-links">
      <a href={withBase("menu")} data-cms-path={JSON.stringify(["homepage", "footer", "menuLabel"])}>{site.footer.menuLabel}</a>
      <a href={site.footer.instagramUrl} target="_blank" rel="noreferrer" data-cms-paths={JSON.stringify([["homepage", "footer", "instagramHandle"], ["homepage", "footer", "instagramUrl"]])}>{site.footer.instagramHandle}</a>
    </div>
  </div>
</footer>
