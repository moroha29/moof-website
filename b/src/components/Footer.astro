---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <p class="foot-logo">{site.brand.wordmark}<span aria-hidden="true">.</span></p>
    <p>{site.findUs.addressLines.join(", ")}</p>
    <p>{site.findUs.operatingDays}, {site.findUs.operatingHours}</p>
    <div class="footer-links">
      <a href={withBase("menu")}>{site.brand.footerMenuLabel}</a>
      <a href={site.instagram.url} target="_blank" rel="noreferrer">{site.instagram.handle}</a>
    </div>
  </div>
</footer>
