---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";
---

<section class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <span class="hero-eyebrow">{site.hero.eyebrow}</span>
      <h1>{site.hero.headline}<br /><span class="accent">{site.hero.accent}</span></h1>
      <p class="hero-sub">{site.hero.body}</p>
      <div class="hero-actions">
        <a class="btn btn-pink" href={withBase("menu")}>{site.hero.menuCta}</a>
        <a class="btn" href={`${withBase("/")}#find-us`}>{site.hero.findUsCta}</a>
      </div>
      <div class="hero-meta">
        <span>📍 {site.findUs.addressLines.join(", ")}</span>
        <span>🕘 {site.findUs.operatingDays}, {site.findUs.operatingHours}</span>
      </div>
    </div>
    <div class="hero-art">
      <div class="sticker-frame">
        <img src={withBase(site.hero.image)} alt={site.hero.imageAlt} />
      </div>
      <span class="float-badge b1">{site.hero.badges[0]}</span>
      <span class="float-badge b2">{site.hero.badges[1]}</span>
    </div>
  </div>
</section>
