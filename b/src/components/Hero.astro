---
import { withBase } from "../lib/base.js";
import { site } from "../data/site.js";
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1>{site.hero.headline}</h1>
      <p class="hero-sub">{site.hero.body}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={withBase("menu")}>{site.hero.menuCta}</a>
        <a class="text-link" href={`${withBase("/")}#find-us`}>{site.hero.findUsCta} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="hero-details" aria-label="Moof approach">
        {site.hero.details.map((detail) => <li>{detail}</li>)}
      </ul>
    </div>
    <div class="hero-image">
      <div class="hero-image-wash" aria-hidden="true"></div>
      <img src={withBase(site.hero.image)} alt={site.hero.imageAlt} />
      <p class="image-caption">Curated matcha &amp; hojicha</p>
    </div>
  </div>
</section>
