---
import BaseLayout from "../layouts/BaseLayout.astro";
import DrinkCard from "../components/DrinkCard.astro";
import { coreMenu, seasonalMenu } from "../data/menu.js";
import { site } from "../data/site.js";
---

<BaseLayout
  title={site.seo.menuTitle}
  description={site.seo.menuDescription}
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">{site.menuPage.eyebrow}</p>
        <h1>{site.menuPage.heading}</h1>
        <p>{site.menuPage.intro}</p>
      </div>
    </section>

    <section class="menu-page-section">
      <div class="wrap">
        <div class="section-intro">
          <p class="eyebrow">{site.menuPage.coreEyebrow}</p>
          <h2>{site.menuPage.coreHeading}</h2>
          <p>{site.menuPage.coreSchedule}</p>
        </div>
        <div class="menu-grid">
          {coreMenu.map((item) => <DrinkCard {...item} />)}
        </div>
      </div>
    </section>

    <section class="menu-page-section">
      <div class="wrap">
        <div class="section-intro">
          <p class="eyebrow">{site.menuPage.seasonalEyebrow}</p>
          <h2>{site.menuPage.seasonalHeading}</h2>
          <p>{site.menuPage.seasonalIntro}</p>
        </div>
        <div class="menu-grid">
          {seasonalMenu.map((item) => <DrinkCard {...item} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
