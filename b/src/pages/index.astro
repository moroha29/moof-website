---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import IngredientStory from "../components/IngredientStory.astro";
import MenuShowcase from "../components/MenuShowcase.astro";
import FindUs from "../components/FindUs.astro";
import InstaFollow from "../components/InstaFollow.astro";
import { site } from "../data/site.js";
---

<BaseLayout
  title={site.seo.homeTitle}
  description={site.seo.homeDescription}
>
  <main>
    <Hero />
    <IngredientStory />
    <MenuShowcase />
    <FindUs />
    <InstaFollow />
  </main>
</BaseLayout>
