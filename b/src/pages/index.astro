---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import IngredientStory from "../components/IngredientStory.astro";
import MenuShowcase from "../components/MenuShowcase.astro";
import FindUs from "../components/FindUs.astro";
import InstaFollow from "../components/InstaFollow.astro";
---

<BaseLayout
  title="Moof — Specialty Matcha & Hojicha Bar, Tanjong Pagar"
  description="Moof is a specialty matcha and hojicha bar in Singapore's CBD, hand-whisking ceremonial-grade drinks with exclusive Japanese matcha Mori and Shiran."
>
  <main>
    <Hero />
    <IngredientStory />
    <MenuShowcase />
    <FindUs />
    <InstaFollow />
  </main>
</BaseLayout>
