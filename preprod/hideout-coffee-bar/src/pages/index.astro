---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hideout Coffee Bar</title>
    <meta name="description" content="A day coffee bar and Friday/Saturday night bar at Mackenzie Road, Singapore. Filter coffee, chalkboard sandwiches, and a wall of vinyl." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --cream: #F1E8D8;
        --cream-deep: #E6DAC3;
        --maroon: #6E1F2A;
        --amber: #8B5A34;
        --ink: #241A12;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-7: 3rem;
        --space-9: 6rem;
        --space-10: 8rem;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--cream); color: var(--ink);
        font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
        font-size: 1rem; line-height: 1.65;
      }
      h1, h2, h3 { font-family: "Alegreya", Georgia, serif; margin: 0; color: var(--maroon); }
      a { color: var(--maroon); }
      .skip-link { position: absolute; left: -999px; top: 0; }
      .skip-link:focus {
        left: var(--space-5); top: var(--space-5); background: var(--maroon); color: var(--cream);
        padding: 0.5rem 1rem; border-radius: 4px; z-index: 20;
      }
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: var(--space-5) clamp(1.25rem, 5vw, 3.5rem);
        border-bottom: 1px solid var(--cream-deep);
      }
      .wordmark {
        display: flex; align-items: center; gap: 0.7rem;
        font-family: "Alegreya", serif; font-weight: 700;
        font-size: 1.2rem; color: var(--maroon); text-decoration: none;
      }
      .wordmark img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
      .peek-icon { width: 22px; height: 22px; color: var(--maroon); flex-shrink: 0; }
      nav a {
        color: var(--ink); text-decoration: none; margin-left: var(--space-5);
        font-family: "Manrope", sans-serif; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em;
        font-size: 0.875rem; position: relative; padding-bottom: 4px;
      }
      nav a::after {
        content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: 1.5px;
        background: var(--maroon); transform: scaleX(0); transform-origin: left;
        transition: transform 0.2s ease-out;
      }
      nav a:hover::after, nav a:focus-visible::after { transform: scaleX(1); }
      nav a:focus-visible { outline: 2px solid var(--maroon); outline-offset: 2px; }

      main { max-width: 1120px; margin: 0 auto; padding: 0 clamp(1.25rem, 5vw, 3.5rem); position: relative; }
      .hero { padding: var(--space-9) 0 var(--space-7); position: relative; overflow: hidden; }
      @media (min-width: 1024px) { .hero { padding-top: var(--space-10); } }
      .hero-watermark {
        position: absolute; right: -60px; bottom: -40px; width: 460px; height: 460px;
        color: var(--amber); opacity: 0.07; pointer-events: none; z-index: 0;
      }
      .hero-content { position: relative; z-index: 1; }
      .eyebrow {
        color: var(--amber); text-transform: uppercase; letter-spacing: 0.08em;
        font-family: "Manrope", sans-serif; font-weight: 500;
        font-size: 0.8125rem; margin: 0 0 var(--space-4);
      }
      .hero h1 {
        font-weight: 700; letter-spacing: -0.01em; line-height: 1.05;
        font-size: clamp(2.5rem, 3.5vw + 1.5rem, 4rem);
        margin: 0; max-width: 15ch;
      }
      .photo {
        position: relative; overflow: hidden; border-radius: 6px;
        border: 1px solid var(--cream-deep); background: var(--cream-deep);
      }
      .photo img { display: block; width: 100%; height: 100%; object-fit: contain; transition: transform 0.4s ease; }
      .photo:hover img { transform: scale(1.02); }
      @media (prefers-reduced-motion: reduce) { .photo:hover img { transform: none; } }
      .hero-photo { height: 420px; margin-top: var(--space-6); }

      .peek-divider { display: flex; justify-content: center; margin: var(--space-9) 0; }
      .peek-divider .peek-icon { width: 56px; height: 56px; color: var(--maroon); opacity: 0.6; }

      section { padding: var(--space-7) 0; }
      @media (min-width: 1024px) { section { padding: var(--space-9) 0; } }
      /* Visible by default so content never depends on JS/IntersectionObserver
         succeeding. .will-animate (added by script, only once JS has run and
         observed the element) opts into the hidden pre-reveal state; .is-visible
         then animates it in. If JS never runs, content simply stays visible. */
      .reveal.will-animate {
        opacity: 0; transform: translateY(12px);
        clip-path: inset(42% 0 42% 0);
        transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.5s cubic-bezier(0.22,1,0.36,1), clip-path 0.7s cubic-bezier(0.22,1,0.36,1);
      }
      .reveal.will-animate.is-visible { opacity: 1; transform: translateY(0); clip-path: inset(0 0 0 0); }
      @media (prefers-reduced-motion: reduce) {
        .reveal.will-animate { opacity: 1; transform: none; clip-path: none; transition: none; }
      }
      .kicker {
        color: var(--amber); text-transform: uppercase; letter-spacing: 0.08em;
        font-family: "Manrope", sans-serif; font-weight: 500;
        font-size: 0.8125rem; margin: 0 0 var(--space-4);
      }
      h2 { font-weight: 600; letter-spacing: -0.01em; font-size: clamp(1.75rem, 1.5vw + 1.25rem, 2.4rem); }
      .about-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-6); align-items: center; }
      .about p { max-width: 62ch; color: var(--ink); margin: 0; }
      .about-photo { height: 340px; }
      .menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-5); margin-top: var(--space-6); }
      .menu-card { background: var(--cream-deep); border-radius: 6px; padding: var(--space-5); }
      .menu-card .tag {
        font-family: "Manrope", sans-serif; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;
        color: var(--amber); margin: 0 0 0.4rem; font-weight: 600;
      }
      .menu-card h3 { font-size: 1.125rem; font-weight: 500; margin: 0 0 0.3rem; }
      .menu-card p { margin: 0; color: var(--ink); opacity: 0.75; font-size: 0.9375rem; }
      .visit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); margin-top: var(--space-4); }
      .visit-grid h3 { font-family: "Alegreya", serif; font-weight: 600; font-size: 1.0625rem; margin: 0 0 0.4rem; color: var(--amber); }
      .visit-grid p { margin: 0; color: var(--ink); }
      footer {
        padding: var(--space-6) clamp(1.25rem, 5vw, 3.5rem) var(--space-7);
        color: var(--maroon); font-size: 0.85rem; text-align: center;
        display: flex; flex-direction: column; align-items: center; gap: var(--space-3);
      }
      footer .peek-icon { width: 26px; height: 26px; opacity: 0.7; }
      @media (max-width: 560px) {
        .visit-grid { grid-template-columns: 1fr; }
        .about-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="peek" viewBox="0 0 64 64">
        <path d="M6,44 Q18,10 30,44" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" />
        <path d="M16,48 Q32,8 48,48" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" />
        <path d="M26,50 Q42,12 58,44" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" />
      </symbol>
    </svg>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a class="wordmark" href={base}>
        <img src={`${base}images/logo.png`} alt="" />
        Hideout Coffee Bar
      </a>
      <nav aria-label="Primary">
        <a href={base}>Home</a>
        <a href={`${base}menu/`}>Menu</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-heading">
        <svg class="hero-watermark" aria-hidden="true"><use href="#peek" /></svg>
        <div class="hero-content">
          <p class="eyebrow">Coffee Bar &middot; Mackenzie Road, Singapore</p>
          <h1 id="hero-heading">The people who give Hideout its heart.</h1>
          <div class="photo hero-photo">
            <img src={`${base}images/bar-interior.png`} alt="Hideout Coffee Bar interior: dark wood counter, maroon-tiled counter face, vinyl records on display, pendant lighting" />
          </div>
        </div>
      </section>

      <div class="peek-divider" aria-hidden="true">
        <svg class="peek-icon"><use href="#peek" /></svg>
      </div>

      <section class="about reveal" aria-labelledby="about-heading">
        <p class="kicker">About</p>
        <h2 id="about-heading">By day, a coffee bar. By night, a bar.</h2>
        <div class="about-grid">
          <p>
            By day, a coffee bar &mdash; filter coffee and cold brew, chalkboard sandwiches, a quiet corner
            behind a wall of vinyl. By night, Friday and Saturday, the same room turns into a bar. Two years
            in, still run by the same familiar faces behind the counter, week after week, some since day one.
          </p>
          <div class="photo about-photo">
            <img src={`${base}images/menu-board.png`} alt="Real chalkboard menu board with pricing for coffee, sandwiches, non-coffee drinks and sweets" />
          </div>
        </div>
      </section>

      <section class="menu-preview reveal" aria-labelledby="menu-heading">
        <p class="kicker">On the menu</p>
        <h2 id="menu-heading">Filter coffee, chalkboard sandwiches</h2>
        <div class="menu-grid">
          <div class="menu-card">
            <p class="tag">Coffee</p>
            <h3>Filter</h3>
            <p>$8</p>
          </div>
          <div class="menu-card">
            <p class="tag">Coffee</p>
            <h3>Cold Brew</h3>
            <p>$7.50</p>
          </div>
          <div class="menu-card">
            <p class="tag">Sandwiches</p>
            <h3>Tuna Melt</h3>
            <p>$14</p>
          </div>
          <div class="menu-card">
            <p class="tag">Sandwiches</p>
            <h3>Salt Beef</h3>
            <p>$18</p>
          </div>
          <div class="menu-card">
            <p class="tag">Sweets</p>
            <h3>Banana Bread</h3>
            <p>With espresso butter &mdash; $8.50</p>
          </div>
          <div class="menu-card">
            <p class="tag">Non-Coffee</p>
            <h3>Jamu Soda</h3>
            <p>$7.50</p>
          </div>
        </div>
        <p style="margin-top:1.5rem;"><a href={`${base}menu/`}>See the full menu &rarr;</a></p>
      </section>

      <section class="visit reveal" aria-labelledby="visit-heading">
        <p class="kicker">Visit</p>
        <h2 id="visit-heading">Find us at Mackenzie Road</h2>
        <div class="visit-grid">
          <div>
            <h3>Address</h3>
            <p>122 Mackenzie Rd<br />Singapore 228711</p>
          </div>
          <div>
            <h3>Hours</h3>
            <p>Day: Tue&ndash;Fri 9:30am&ndash;5:30pm<br />Sat&ndash;Sun 8:30am&ndash;5:30pm<br />After Hours: Fri&ndash;Sat 7pm&ndash;11:59pm<br />Closed Mondays</p>
          </div>
        </div>
      </section>
    </main>
    <footer>
      <svg class="peek-icon"><use href="#peek" /></svg>
      <p>Hideout Coffee Bar &middot; Demo preview, not a live site</p>
    </footer>
    <script>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        const revealEls = document.querySelectorAll(".reveal");
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.2, rootMargin: "0px 0px -10% 0px" }
        );
        revealEls.forEach((el) => {
          el.classList.add("will-animate");
          observer.observe(el);
          // Safety net: if the observer never fires (e.g. element already
          // in view before observation, or an environment quirk), don't
          // leave content permanently invisible.
          setTimeout(() => el.classList.add("is-visible"), 1500);
        });
      }
    </script>
  </body>
</html>
