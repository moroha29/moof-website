---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Menu — SOD Cafe</title>
    <meta name="description" content="All-day breakfast and build-your-own pasta at SOD Cafe, Longhaus." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --cream: #F7F3E8;
        --cream-deep: #ECE5D2;
        --sage: #A8BC93;
        --ink: #201D1A;
        --coral: #C1503F;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-7: 3rem;
        --space-8: 4rem;
      }
      * { box-sizing: border-box; }
      html { font-size: 106.25%; }
      body {
        margin: 0; background: var(--cream); color: var(--ink);
        font-family: "Inter", ui-sans-serif, system-ui, sans-serif; line-height: 1.6; font-size: 1rem;
      }
      h1, h2 { font-family: "Baloo 2", sans-serif; margin: 0; color: var(--ink); }
      a { color: var(--coral); }
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: var(--space-5) clamp(1.25rem, 5vw, 3.5rem); border-bottom: 1px solid var(--cream-deep);
      }
      .wordmark {
        display: flex; align-items: center; gap: 0.6rem;
        font-family: "Baloo 2", sans-serif; font-weight: 700;
        font-size: 1.2rem; color: var(--ink); text-decoration: none;
      }
      .wordmark img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
      nav { display: flex; align-items: center; gap: var(--space-3); }
      nav a {
        color: var(--ink); text-decoration: none;
        font-family: "Inter", sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em;
        font-size: 0.875rem; position: relative; padding-bottom: 4px;
      }
      nav a::after {
        content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: 2px;
        background: var(--coral); transform: scaleX(0); transform-origin: center;
        transition: transform 0.15s ease-out;
      }
      nav a:hover::after, nav a:focus-visible::after { transform: scaleX(1); }
      nav a:focus-visible { outline: 2px solid var(--coral); outline-offset: 2px; }
      .dots { display: inline-flex; align-items: center; gap: 4px; }
      .dots span { display: inline-block; border-radius: 50%; }
      .dots.inline span:nth-child(1) { width: 8px; height: 8px; background: var(--coral); }
      .dots.inline span:nth-child(2) { width: 14px; height: 14px; background: var(--ink); margin-top: -3px; }
      .dots.inline span:nth-child(3) { width: 10px; height: 10px; background: var(--sage); margin-top: 2px; }
      main { max-width: 780px; margin: 0 auto; padding: var(--space-7) clamp(1.25rem, 5vw, 3.5rem) var(--space-8); }
      .kicker {
        color: var(--coral); text-transform: uppercase; letter-spacing: 0.06em;
        font-family: "Inter", sans-serif; font-weight: 600;
        font-size: 0.875rem; margin: 0 0 var(--space-4);
      }
      h1 { font-weight: 800; letter-spacing: -0.01em; font-size: clamp(2rem, 1.5rem + 2vw, 3rem); }
      .menu-group { margin-top: var(--space-7); }
      .menu-group h2 { border-bottom: 1px solid var(--cream-deep); padding-bottom: 0.6rem; font-size: 1.75rem; font-weight: 700; }
      .item { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); padding: 0.9rem 0; border-bottom: 1px solid var(--cream-deep); }
      .item h3 { font-family: "Inter", sans-serif; font-weight: 600; font-size: 1rem; margin: 0 0 0.25rem; color: var(--ink); }
      .item p { margin: 0; color: var(--ink); opacity: 0.75; font-size: 0.9rem; }
      .price { font-family: "Inter", sans-serif; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--coral); white-space: nowrap; }
    </style>
  </head>
  <body>
    <header>
      <a class="wordmark" href={base}><img src={`${base}images/logo.png`} alt="" /> SOD Cafe</a>
      <nav aria-label="Primary">
        <a href={base}>Home</a>
        <span class="dots inline" aria-hidden="true"><span></span><span></span><span></span></span>
        <a href={`${base}menu/`}>Menu</a>
      </nav>
    </header>
    <main>
      <p class="kicker">Menu</p>
      <h1>Breakfast, pasta &amp; more</h1>

      <div class="menu-group">
        <h2>All-Day Breakfast</h2>
        <div class="item">
          <div>
            <h3>French Toast Breakfast</h3>
            <p>Sausage, scrambled egg, maple syrup</p>
          </div>
          <span class="price">$14.90</span>
        </div>
      </div>

      <div class="menu-group">
        <h2>Build-Your-Own Pasta</h2>
        <div class="item">
          <div>
            <h3>Tomyum Fried Chicken Pasta</h3>
            <p>Choose your spice level</p>
          </div>
          <span class="price">$17.90</span>
        </div>
        <div class="item">
          <div><h3>Aglio Olio Seafood Pasta</h3></div>
          <span class="price">$17.90</span>
        </div>
        <div class="item">
          <div><h3>Mala Pasta</h3></div>
          <span class="price">$15.90</span>
        </div>
      </div>

      <div class="menu-group">
        <h2>Drinks</h2>
        <div class="item">
          <div><h3>Bubble Tea / Boba</h3></div>
        </div>
      </div>

      <p style="margin-top: var(--space-7); color: var(--ink); opacity: 0.6; font-size: 0.85rem;">
        Prices available in-store &mdash; this is a preview, not the final menu.
      </p>
    </main>
  </body>
</html>
