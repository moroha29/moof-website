---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Menu — Oasis Bistro &amp; Cafe</title>
    <meta name="description" content="Steaks, fish & chips, lamb rack and comfort classics at Oasis Bistro & Cafe." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --ink: #1A1A1A;
        --red: #C41E3A;
        --gold: #D4A24C;
        --cream: #F5F1EA;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-7: 3rem;
        --space-8: 4rem;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--cream); color: var(--ink);
        font-family: "Work Sans", system-ui, sans-serif; line-height: 1.6; font-size: 1.0625rem;
      }
      h1, h2 { font-family: "Oswald", sans-serif; margin: 0; color: var(--ink); }
      a { color: var(--red); }
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: var(--space-5) clamp(1.25rem, 5vw, 3rem);
      }
      .wordmark {
        display: flex; align-items: center; gap: 0.6rem;
        font-family: "Oswald", sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em;
        font-size: 1.15rem; color: var(--ink); text-decoration: none;
      }
      .wordmark img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
      nav a {
        color: var(--ink); text-decoration: none; margin-left: var(--space-5);
        font-family: "Work Sans", sans-serif; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em;
        font-size: 0.9375rem;
        padding-bottom: 2px; border-bottom: 2px solid transparent;
        transition: border-color 0.15s ease-out, color 0.15s ease-out;
      }
      nav a:hover, nav a:focus-visible { color: var(--red); border-color: var(--red); }
      nav a:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
      main { max-width: 900px; margin: 0 auto; padding: var(--space-7) clamp(1.25rem, 5vw, 3rem) var(--space-8); }
      .kicker {
        color: var(--red); text-transform: uppercase; letter-spacing: 0.04em;
        font-family: "Oswald", sans-serif; font-weight: 600;
        font-size: 1.125rem; margin: 0 0 var(--space-4);
      }
      h1 { font-weight: 700; text-transform: uppercase; letter-spacing: 0.01em; font-size: clamp(2rem, 4vw + 1rem, 3rem); }
      .menu-group { margin-top: var(--space-7); }
      .menu-group h2 {
        font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em;
        border-bottom: 2px solid var(--ink); padding-bottom: 0.6rem; font-size: 1.375rem;
      }
      .item { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); padding: 0.9rem 0; border-bottom: 1px solid #E4DCCB; }
      .item h3 { font-family: "Work Sans", sans-serif; font-size: 1rem; margin: 0 0 0.25rem; font-weight: 600; }
      .item p { margin: 0; color: #5C564C; font-size: 0.9rem; }
      .price { font-family: "Work Sans", sans-serif; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--red); white-space: nowrap; }
    </style>
  </head>
  <body>
    <header>
      <a class="wordmark" href={base}><img src={`${base}images/logo.png`} alt="" /> Oasis Bistro &amp; Cafe</a>
      <nav aria-label="Primary">
        <a href={base}>Home</a>
        <a href={`${base}menu/`}>Menu</a>
      </nav>
    </header>
    <main>
      <p class="kicker">Menu</p>
      <h1>Steaks, sides &amp; comfort classics</h1>

      <div class="menu-group">
        <h2>Mains</h2>
        <div class="item">
          <div><h3>Angus Ribeye</h3></div>
        </div>
        <div class="item">
          <div>
            <h3>Fish &amp; Chips</h3>
            <p>Beer-battered white snapper, crinkle-cut fries, tangy tartar sauce</p>
          </div>
        </div>
        <div class="item">
          <div><h3>Australian Lamb Rack</h3></div>
        </div>
        <div class="item">
          <div><h3>Burgers</h3></div>
        </div>
      </div>

      <div class="menu-group">
        <h2>Sides &amp; Soup</h2>
        <div class="item">
          <div><h3>Creamy Mushroom Soup</h3></div>
        </div>
      </div>

      <div class="menu-group">
        <h2>Set Menus</h2>
        <div class="item">
          <div>
            <h3>Sichuan Mala Set</h3>
            <p>Sichuan mala, pickled cabbage, rice, soup and bread</p>
          </div>
          <span class="price">$18.90</span>
        </div>
      </div>

      <div class="menu-group">
        <h2>Drinks</h2>
        <div class="item">
          <div><h3>Coconut Ice Blend</h3></div>
        </div>
      </div>

      <p style="margin-top: var(--space-7); color: #8A8478; font-size: 0.85rem;">
        Prices available in-store &mdash; this is a preview, not the final menu.
      </p>
    </main>
  </body>
</html>
