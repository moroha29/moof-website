---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
const lightSizes = [14, 12, 10, 8, 6, 5, 4, 5, 6, 8, 10, 12, 14];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Oasis Bistro &amp; Cafe</title>
    <meta name="description" content="A bistro and events venue at AA Centre, Alexandra, Singapore. Steaks, fish & chips, lamb rack and a string-lit terrace." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --ink: #1A1A1A;
        --red: #C41E3A;
        --gold: #D4A24C;
        --cream: #F5F1EA;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-7: 3rem;
        --space-8: 4rem;
        --space-9: 6rem;
        --space-10: 8rem;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--cream); color: var(--ink);
        font-family: "Work Sans", system-ui, -apple-system, sans-serif;
        font-size: 1.0625rem; line-height: 1.6;
      }
      h1, h2, h3 { font-family: "Oswald", sans-serif; margin: 0; color: var(--ink); }
      a { color: var(--red); }
      .skip-link { position: absolute; left: -999px; top: 0; }
      .skip-link:focus {
        left: var(--space-5); top: var(--space-5); background: var(--gold); color: var(--ink);
        padding: 0.5rem 1rem; border-radius: 4px; z-index: 20;
      }
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: var(--space-5) clamp(1.25rem, 5vw, 3rem);
        background: var(--cream);
      }
      .wordmark {
        display: flex; align-items: center; gap: 0.6rem;
        font-family: "Oswald", sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em;
        font-size: 1.15rem; color: var(--ink); text-decoration: none;
      }
      .wordmark img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
      nav a {
        color: var(--ink); text-decoration: none; margin-left: var(--space-5);
        font-family: "Work Sans", sans-serif; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em;
        font-size: 0.9375rem;
        padding-bottom: 2px; border-bottom: 2px solid transparent;
        transition: border-color 0.15s ease-out, color 0.15s ease-out;
      }
      nav a:hover, nav a:focus-visible { color: var(--red); border-color: var(--red); }
      nav a:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

      .hero {
        position: relative; overflow: hidden;
        min-height: 560px; display: flex; align-items: flex-end;
      }
      .hero-photo {
        position: absolute; inset: 0; width: 100%; height: 100%;
        object-fit: cover; object-position: center;
        animation: kenburns 18s ease-out 1 forwards;
      }
      @keyframes kenburns { from { transform: scale(1); } to { transform: scale(1.06); } }
      @media (prefers-reduced-motion: reduce) { .hero-photo { animation: none; } }
      .hero::after {
        content: ""; position: absolute; inset: 0;
        background: linear-gradient(0deg, rgba(26,26,26,0.88) 0%, rgba(26,26,26,0.35) 55%, rgba(26,26,26,0.15) 100%);
      }
      .hero-content { position: relative; z-index: 1; padding: var(--space-8) clamp(1.25rem, 5vw, 3rem) var(--space-9); color: var(--cream); max-width: 900px; }
      .eyebrow {
        color: var(--gold); text-transform: uppercase; letter-spacing: 0.08em;
        font-family: "Work Sans", sans-serif; font-weight: 600;
        font-size: 0.9375rem; margin: 0 0 var(--space-4);
      }
      .hero h1 {
        color: var(--cream);
        font-weight: 700; text-transform: uppercase; letter-spacing: 0.01em;
        font-size: clamp(2.5rem, 6vw + 1rem, 5rem); line-height: 1.02;
        margin: 0; max-width: 14ch;
        opacity: 0; transform: translateY(14px);
        animation: rise 0.45s ease-out 0.1s forwards;
      }
      @media (prefers-reduced-motion: reduce) { .hero h1 { opacity: 1; transform: none; animation: none; } }
      @keyframes rise { to { opacity: 1; transform: translateY(0); } }

      .lights-divider {
        background: var(--ink);
        padding: var(--space-6) 0;
        display: flex; justify-content: center;
      }
      .lights-row { display: flex; align-items: flex-end; gap: clamp(18px, 3vw, 28px); }
      .light-dot {
        display: block; border-radius: 50%;
        background: radial-gradient(circle at 35% 35%, #F0CE8A 0%, #D4A24C 55%, #B9822F 100%);
        box-shadow: 0 0 8px rgba(212,162,76,0.55);
        animation: twinkle 2.4s ease-in-out infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        .light-dot { animation: none; box-shadow: 0 0 8px rgba(212,162,76,0.47); }
      }
      @keyframes twinkle {
        0%, 100% { box-shadow: 0 0 8px rgba(212,162,76,0.55); }
        50% { box-shadow: 0 0 4px rgba(212,162,76,0.36); }
      }

      main { max-width: 1180px; margin: 0 auto; padding: 0 clamp(1.25rem, 5vw, 3rem); }
      section { padding: var(--space-8) 0; }
      @media (min-width: 1024px) { section { padding: var(--space-9) 0; } }
      .reveal { opacity: 0; transform: translateY(12px); transition: opacity 0.4s ease-out, transform 0.4s ease-out; }
      .reveal.is-visible { opacity: 1; transform: translateY(0); }
      @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
      .kicker {
        color: var(--red); text-transform: uppercase; letter-spacing: 0.04em;
        font-family: "Oswald", sans-serif; font-weight: 600;
        font-size: 1.125rem; margin: 0 0 var(--space-4);
      }
      .about-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-6); align-items: center; }
      .about p { max-width: 62ch; color: var(--ink); margin: 0; }
      .photo { position: relative; overflow: hidden; border-radius: 4px; border: 1px solid #E4DCCB; background: #E4DCCB; }
      .photo img { display: block; width: 100%; height: 100%; object-fit: contain; }
      .about-photo { height: 340px; }

      .menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--space-5); margin-top: var(--space-6); }
      .menu-card { background: var(--ink); color: var(--cream); border-radius: 4px; padding: var(--space-5); border-left: 4px solid var(--red); }
      .menu-card h3 {
        font-size: 1.0625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em;
        margin: 0 0 0.4rem; color: var(--cream);
      }
      .menu-card p { margin: 0; color: #C9C2B4; font-size: 0.92rem; }

      .gallery-photo { height: 320px; margin-top: var(--space-6); }

      .visit-inner { max-width: 1180px; margin: 0 auto; padding: var(--space-8) clamp(1.25rem, 5vw, 3rem); }
      @media (min-width: 1024px) { .visit-inner { padding-top: var(--space-9); padding-bottom: var(--space-9); } }
      .visit-section { background: var(--ink); color: var(--cream); }
      .visit-section .kicker { color: var(--gold); }
      .visit-section h2 { color: var(--cream); }
      .visit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); margin-top: var(--space-4); }
      .visit-grid h3 { font-family: "Oswald", sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; font-size: 1rem; margin: 0 0 0.4rem; color: var(--gold); }
      .visit-grid p { margin: 0; color: #C9C2B4; }

      footer {
        background: var(--ink); color: #8A8478; font-size: 0.85rem; text-align: center;
        padding: var(--space-5) clamp(1.25rem, 5vw, 3rem) var(--space-7);
      }
      @media (max-width: 560px) {
        .visit-grid { grid-template-columns: 1fr; }
        .about-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a class="wordmark" href={base}><img src={`${base}images/logo.png`} alt="" /> Oasis Bistro &amp; Cafe</a>
      <nav aria-label="Primary">
        <a href={base}>Home</a>
        <a href={`${base}menu/`}>Menu</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="hero-heading">
      <img class="hero-photo" src={`${base}images/terrace-night.png`} alt="String-lit outdoor terrace walkway at Oasis Bistro & Cafe at night" />
      <div class="hero-content">
        <p class="eyebrow">Bistro &amp; Events Venue &middot; AA Centre, Alexandra</p>
        <h1 id="hero-heading">Your oasis for great food and great ambience.</h1>
      </div>
    </section>

    <div class="lights-divider" aria-hidden="true">
      <div class="lights-row">
        {lightSizes.map((size, i) => (
          <span class="light-dot" style={`width:${size}px; height:${size}px; animation-delay:${i * 140}ms;`}></span>
        ))}
      </div>
    </div>

    <main id="main">
      <section class="about reveal" aria-labelledby="about-heading">
        <p class="kicker">About</p>
        <h2 id="about-heading">Hearty plates, built for lingering</h2>
        <div class="about-grid">
          <p>
            Oasis Bistro &amp; Cafe brings hearty, comfort-driven plates &mdash; sizzling Angus ribeye,
            beer-battered fish &amp; chips, Australian lamb rack, juicy burgers &mdash; to a space built for
            lingering, whether that's a weekday coffee or a Saturday night out. By day, a bold red counter
            and full drinks case; by evening, a string-lit terrace built for a proper night out. Beyond the
            daily menu, Oasis also caters birthdays, corporate events and private parties &mdash; host your
            event in style.
          </p>
          <div class="photo about-photo">
            <img src={`${base}images/steak-salad.png`} alt="Angus ribeye steak with rosemary garnish and mixed salad" />
          </div>
        </div>
      </section>

      <section class="menu-preview reveal" aria-labelledby="menu-heading">
        <p class="kicker">On the menu</p>
        <h2 id="menu-heading">Steaks, sides &amp; comfort classics</h2>
        <div class="menu-grid">
          <div class="menu-card">
            <h3>Angus Ribeye</h3>
            <p>Sizzling steak, served with our house sauce</p>
          </div>
          <div class="menu-card">
            <h3>Fish &amp; Chips</h3>
            <p>Beer-battered white snapper, crinkle-cut fries, tangy tartar sauce</p>
          </div>
          <div class="menu-card">
            <h3>Australian Lamb Rack</h3>
            <p>Grilled to perfection, rich savoury sauce</p>
          </div>
          <div class="menu-card">
            <h3>Mushroom Soup</h3>
            <p>Creamy, served with bread</p>
          </div>
        </div>
        <div class="photo gallery-photo">
          <img src={`${base}images/interior-counter.png`} alt="Interior of Oasis Bistro & Cafe: red marble-effect counter with a pastry display case and drinks fridge" />
        </div>
        <p style="margin-top:1.5rem;"><a href={`${base}menu/`}>See the full menu &rarr;</a></p>
      </section>
    </main>

    <div class="lights-divider" aria-hidden="true">
      <div class="lights-row">
        {lightSizes.map((size, i) => (
          <span class="light-dot" style={`width:${size}px; height:${size}px; animation-delay:${i * 140}ms;`}></span>
        ))}
      </div>
    </div>

    <section class="visit-section reveal" aria-labelledby="visit-heading">
      <div class="visit-inner">
        <p class="kicker">Visit</p>
        <h2 id="visit-heading">Find us at AA Centre</h2>
        <div class="visit-grid">
          <div>
            <h3>Address</h3>
            <p>2 Kung Chong Rd, #04-01<br />Singapore 159140</p>
          </div>
          <div>
            <h3>Hours</h3>
            <p>Daily 10am&ndash;9pm</p>
          </div>
        </div>
      </div>
    </section>
    <footer>
      <p>Oasis Bistro &amp; Cafe &middot; Demo preview, not a live site</p>
    </footer>
    <script>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.2 }
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
