---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Menu — Benches Cafe</title>
    <meta name="description" content="Coffee, tea and a few simple plates at Benches Cafe, Clementi Woods Park." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,SOFT,WONK,wght@0,9..144,0..100,0..1,300..600&family=Karla:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --emerald: #1B4B43;
        --emerald-ink: #20302C;
        --gold: #C9A227;
        --cream: #F6F2E9;
        --cream-deep: #EDE6D6;
        --moss: #7C8A6E;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-8: 3rem;
        --space-10: 4rem;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--cream); color: var(--emerald-ink);
        font-family: "Karla", system-ui, sans-serif; line-height: 1.7; font-size: 1.0625rem;
      }
      h1, h2 { font-family: "Fraunces", Georgia, serif; font-optical-sizing: auto; color: var(--emerald); margin: 0; }
      h1 { font-variation-settings: "opsz" 100, "SOFT" 80, "WONK" 0, "wght" 380; letter-spacing: -0.015em; }
      h2 { font-variation-settings: "opsz" 40, "SOFT" 60, "WONK" 0, "wght" 500; letter-spacing: -0.005em; }
      a { color: var(--gold); }
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: var(--space-5) clamp(1.25rem, 5vw, 4rem); border-bottom: 1px solid var(--cream-deep);
      }
      .wordmark {
        display: flex; align-items: center; gap: 0.6rem;
        font-family: "Fraunces", Georgia, serif;
        font-variation-settings: "opsz" 24, "SOFT" 60, "WONK" 0, "wght" 500;
        font-size: 1.15rem; color: var(--emerald); text-decoration: none;
      }
      .wordmark img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
      nav a {
        color: var(--emerald); text-decoration: none; margin-left: var(--space-5);
        font-size: 0.9375rem; font-weight: 500; letter-spacing: 0.02em;
        padding-bottom: 2px; border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease, color 0.2s ease;
      }
      nav a:hover, nav a:focus-visible { color: var(--gold); border-color: var(--gold); }
      nav a:focus-visible { outline: 2px solid var(--emerald); outline-offset: 2px; }
      main { max-width: 860px; margin: 0 auto; padding: var(--space-8) clamp(1.25rem, 5vw, 4rem) var(--space-10); }
      .kicker {
        color: var(--moss); text-transform: uppercase; letter-spacing: 0.08em;
        font-size: 0.78rem; margin: 0 0 var(--space-4); font-weight: 600;
      }
      .menu-group { margin-top: var(--space-8); }
      .menu-group h2 { display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px solid var(--cream-deep); padding-bottom: 0.6rem; font-size: 1.5rem; }
      .menu-group h2 svg { width: 20px; height: 20px; color: var(--moss); flex-shrink: 0; }
      .item {
        display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4);
        padding: 0.9rem 0; border-bottom: 1px solid var(--cream-deep);
        transition: background 0.2s ease;
      }
      .item:hover { background: color-mix(in srgb, var(--moss) 6%, var(--cream)); }
      .item h3 { font-family: "Karla", sans-serif; font-size: 1rem; margin: 0; font-weight: 600; color: var(--emerald-ink); }
      .item .note { margin: 0; color: var(--moss); font-size: 0.9rem; }
      .price { font-family: "Karla", sans-serif; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--emerald); white-space: nowrap; }
    </style>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="pinwheel" viewBox="0 0 24 24">
        <path d="M12 12 C12 6 4 4 2 2 C8 2 12 8 12 12 Z" fill="currentColor" />
        <path d="M12 12 C12 6 4 4 2 2 C8 2 12 8 12 12 Z" fill="currentColor" transform="rotate(90 12 12)" />
        <path d="M12 12 C12 6 4 4 2 2 C8 2 12 8 12 12 Z" fill="currentColor" transform="rotate(180 12 12)" />
        <path d="M12 12 C12 6 4 4 2 2 C8 2 12 8 12 12 Z" fill="currentColor" transform="rotate(270 12 12)" />
      </symbol>
    </svg>
    <header>
      <a class="wordmark" href={base}><img src={`${base}images/logo.png`} alt="" /> Benches Cafe</a>
      <nav aria-label="Primary">
        <a href={base}>Home</a>
        <a href={`${base}menu/`}>Menu</a>
      </nav>
    </header>
    <main>
      <p class="kicker">Menu</p>
      <h1>Coffee, tea &amp; a few simple plates</h1>

      <div class="menu-group">
        <h2><svg><use href="#pinwheel" /></svg> Coffee &amp; drinks</h2>
        <div class="item">
          <div>
            <h3>Freshly ground coffee</h3>
            <p class="note">Hot or iced</p>
          </div>
          <span class="price">$10&ndash;20 per person</span>
        </div>
        <div class="item">
          <div><h3>Tea</h3></div>
        </div>
        <div class="item">
          <div><h3>Milkshake</h3></div>
        </div>
      </div>

      <div class="menu-group">
        <h2><svg><use href="#pinwheel" /></svg> From the counter</h2>
        <div class="item">
          <div><h3>Grilled cheese sandwich</h3></div>
        </div>
        <div class="item">
          <div>
            <h3>Waffle</h3>
            <p class="note">Ice cream, salted caramel sauce, powdered sugar</p>
          </div>
        </div>
      </div>

      <p style="margin-top: var(--space-8); color: var(--moss); font-size: 0.85rem;">
        Prices available in-store &mdash; this is a preview, not the final menu.
      </p>
    </main>
  </body>
</html>
