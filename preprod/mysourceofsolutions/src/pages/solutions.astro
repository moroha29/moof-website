---
import pages from "../assets/content/pages.json";
import CallToAction from "../components/CallToAction.astro";
import PageHero from "../components/PageHero.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../lib/base.js";

const content = pages.solutions;
---
<SiteLayout title={content.seo.title} description={content.seo.description} current="solutions">
  <PageHero hero={content.hero} paths={["homepage", "pages", "solutions", "hero"]} />
  <nav class="anchor-nav" aria-label="Solution sections">{content.industries.map((industry) => <a href={`#${industry.slug}`}>{industry.name}</a>)}</nav>

  <div class="industry-list">{content.industries.map((industry, i) => <section class="industry-section" id={industry.slug}>
    <figure><img src={withBase(industry.image)} alt={industry.imageAlt} loading="lazy" /></figure>
    <div>
      <p class="eyebrow">0{i + 1} / {industry.name}</p>
      <h2>{industry.kicker}</h2>
      <div class="industry-block"><h3>Problem we solve</h3><p>{industry.problem}</p></div>
      <div class="industry-block"><h3>Recommended bundle</h3><ul>{industry.bundle.map((item) => <li>{item}</li>)}</ul></div>
      <div class="industry-block"><h3>What this gives you</h3><p>{industry.outcome}</p></div>
      <a class="text-button" href={withBase(`/success-stories/${industry.storySlug}/`)}>{industry.storyLabel} &rarr;</a>
    </div>
  </section>)}</div>
  <CallToAction eyebrow="Your needs do not fit a template?" heading="Good. Your recommendation should not either." body="Tell us what the group, event or campaign needs to achieve. We will shape the product mix around it." />
</SiteLayout>
