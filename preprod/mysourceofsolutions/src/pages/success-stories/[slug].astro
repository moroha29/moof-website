---
import pages from "../../assets/content/pages.json";
import CallToAction from "../../components/CallToAction.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { withBase } from "../../lib/base.js";

export function getStaticPaths() {
  return pages.stories.items.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

const { story } = Astro.props;
const products = pages.products.categories.filter((product) => story.relatedProducts.includes(product.slug));
const solutions = pages.solutions.industries.filter((solution) => story.relatedSolutions.includes(solution.slug));
---
<SiteLayout title={`${story.title} | MySOS Success Story`} description={story.summary} current="stories">
  <section class="story-hero" id="top"><div><p class="eyebrow">Success story / {story.type}</p><h1>{story.title}</h1><p class="lede">{story.summary}</p><strong>{story.result}</strong></div><figure><img src={withBase(story.image)} alt={story.imageAlt} /></figure></section>

  <section class="story-narrative">
    <article><span>01</span><h2>Challenge</h2><p>{story.challenge}</p></article>
    <article><span>02</span><h2>Solution</h2><p>{story.solution}</p></article>
    <article><span>03</span><h2>Outcome</h2><p>{story.outcome}</p></article>
  </section>

  <section class="section story-gallery"><header class="section-heading"><p class="eyebrow">Project gallery</p><h2>A closer look.</h2><p>Selected imagery from the product and event context.</p></header><div>{story.gallery.map((image, i) => <img src={withBase(image)} alt={`${story.title} project gallery image ${i + 1}`} loading="lazy" />)}</div></section>

  <section class="story-quote"><blockquote>&ldquo;{story.testimonial}&rdquo;</blockquote><p>&mdash; {story.person}</p></section>

  <section class="section related-links"><header class="section-heading"><p class="eyebrow">Related products</p><h2>Build from the same ingredients.</h2><p>Explore the product categories used in projects like this one.</p></header><div class="link-grid">{products.map((product) => <a href={withBase(`/products/${product.slug}/`)}><span>{product.name}</span><b>{product.title}</b><em>View products &rarr;</em></a>)}</div></section>
  <section class="section related-links muted-section"><header class="section-heading"><p class="eyebrow">Related solutions</p><h2>See the wider bundle.</h2><p>Recommendations organised around the type of team or event.</p></header><div class="link-grid">{solutions.map((solution) => <a href={withBase(`/solutions/#${solution.slug}`)}><span>{solution.name}</span><b>{solution.kicker}</b><em>View solution &rarr;</em></a>)}</div></section>
  <CallToAction eyebrow="Your project can start here." heading="Bring us the challenge. We will shape the solution." />
</SiteLayout>
