---
import { withBase } from "../lib/base.js";
const { eyebrow = "Have a project in mind?", heading = "Tell us what you need. We will simplify the rest.", body = "Share your audience, quantity, deadline and budget. We will recommend a practical route." } = Astro.props;
---
<section class="final-cta">
  <div><p class="eyebrow">{eyebrow}</p><h2>{heading}</h2><p>{body}</p></div>
  <div class="actions"><a class="button" href={withBase("/#quote")}>Get a quote <span aria-hidden="true">&nearr;</span></a><a class="text-button" href="https://wa.me/6588547109">WhatsApp us &rarr;</a></div>
</section>
