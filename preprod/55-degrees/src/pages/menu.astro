---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : rawBase + "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Menu — 55 Degrees</title>
    <meta name="description" content="Lunch sets, specialty coffee and everyday favourites at 55 Degrees." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --cream: #F7F5EF;
        --cream-deep: #ECE8DD;
        --brown: #8B6B4A;
        --sage: #B9C4A6;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-7: 3rem;
        --space-8: 4rem;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--cream); color: #3A322A;
        font-family: "Public Sans", ui-sans-serif, system-ui, sans-serif; line-height: 1.6; font-size: 1rem;
      }
      h1, h2 { font-family: "Archivo", ui-sans-serif, sans-serif; margin: 0; color: var(--brown); }
      a { color: var(--brown); }
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: var(--space-5) clamp(1.25rem, 5vw, 3.5rem); border-bottom: 1px solid var(--cream-deep);
      }
      .wordmark {
        display: flex; align-items: center; gap: 0.6rem;
        font-family: "Archivo", sans-serif; font-weight: 600;
        font-size: 1.1rem; color: var(--brown); text-decoration: none;
      }
      .wordmark img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
      nav { display: flex; gap: var(--space-5); }
      nav a {
        display: inline-flex; align-items: center; gap: 0.4rem;
        color: #3A322A; text-decoration: none;
        font-family: "Public Sans", sans-serif; font-weight: 500; font-size: 0.9375rem;
      }
      .ring-sm { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid rgba(139, 107, 74, 0.35); display: inline-block; flex-shrink: 0; }
      main { max-width: 780px; margin: 0 auto; padding: var(--space-7) clamp(1.25rem, 5vw, 3.5rem) var(--space-8); }
      .kicker {
        color: var(--brown); opacity: 0.7; text-transform: uppercase; letter-spacing: 0.08em;
        font-family: "Public Sans", sans-serif; font-weight: 500;
        font-size: 0.8125rem; margin: 0 0 var(--space-4);
      }
      h1 { font-weight: 600; letter-spacing: -0.02em; font-size: clamp(1.75rem, 2.5vw + 1rem, 2.5rem); }
      .menu-group { margin-top: var(--space-7); }
      .menu-group h2 {
        display: flex; align-items: center; gap: var(--space-3);
        font-weight: 600; letter-spacing: -0.01em; font-size: 1.375rem;
        border-bottom: 1px solid var(--cream-deep); padding-bottom: 0.6rem;
      }
      .item { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); padding: 0.9rem 0; border-bottom: 1px solid var(--cream-deep); }
      .item h3 { font-family: "Public Sans", sans-serif; font-weight: 600; font-size: 1rem; margin: 0; color: #3A322A; }
      .price { font-family: "Public Sans", sans-serif; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--brown); white-space: nowrap; }
    </style>
  </head>
  <body>
    <header>
      <a class="wordmark" href={base}><img src={`${base}images/logo.png`} alt="" /> 55 Degrees</a>
      <nav aria-label="Primary">
        <a href={base}><span class="ring-sm"></span>Home</a>
        <a href={`${base}menu/`}><span class="ring-sm"></span>Menu</a>
      </nav>
    </header>
    <main>
      <p class="kicker">Menu</p>
      <h1>Lunch sets &amp; everyday favourites</h1>

      <div class="menu-group">
        <h2><span class="ring-sm"></span> Lunch</h2>
        <div class="item">
          <div><h3>Beefball Pasta</h3></div>
          <span class="price">$10.90</span>
        </div>
      </div>

      <div class="menu-group">
        <h2><span class="ring-sm"></span> Coffee</h2>
        <div class="item">
          <div><h3>Flat White</h3></div>
          <span class="price">$5.00</span>
        </div>
        <div class="item">
          <div><h3>Taro Latte</h3></div>
          <span class="price">$5.00</span>
        </div>
      </div>

      <div class="menu-group">
        <h2><span class="ring-sm"></span> Bakery</h2>
        <div class="item">
          <div><h3>Assorted Muffins</h3></div>
          <span class="price">$4.50</span>
        </div>
      </div>

      <p style="margin-top: var(--space-7); color: var(--brown); opacity: 0.6; font-size: 0.85rem;">
        Prices available in-store &mdash; this is a preview, not the final menu.
      </p>
    </main>
  </body>
</html>
