---
import { site } from "../data/site.js";
import { withBase } from "../lib/base.js";
---

<header class="site-header">
  <div class="utility-bar">
    <span>{site.visit.address}</span>
    <span>{site.visit.hours}</span>
  </div>
  <div class="masthead">
    <a class="wordmark" href={withBase("/")} aria-label="Moof home">{site.wordmark}</a>
    <nav aria-label="Primary navigation">
      <a href={withBase("/menu/")}>{site.navigation.menu}</a>
      <a href={withBase("/#story")}>{site.navigation.about}</a>
      <a href={withBase("/#visit")}>{site.navigation.visit}</a>
    </nav>
  </div>
</header>
