---
import { site } from "../data/site.js";
import { withBase } from "../lib/base.js";
---

<header class="site-header">
  <div class="utility-bar">
    <span>{site.visit.address}</span>
    <span>{site.visit.hours}</span>
  </div>
  <div class="masthead">
    <a class="wordmark" href={withBase("/")} aria-label="Moof home">moof</a>
    <nav aria-label="Primary navigation">
      <a href={withBase("/menu/")}>Menu</a>
      <a href={withBase("/#story")}>About</a>
      <a href={withBase("/#visit")}>Visit</a>
    </nav>
  </div>
</header>
