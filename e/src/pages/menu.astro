---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import MenuList from "../components/MenuList.astro";
import Footer from "../components/Footer.astro";
import { coreMenu, seasonalMenu } from "../data/menu.js";
import { menuMedia } from "../data/editorial.js";
import { site } from "../data/site.js";
import { withBase } from "../lib/base.js";
---

<BaseLayout title={site.seo.menuTitle} description={site.seo.menuDescription}>
  <Header />
  <main class="menu-page">
    <section class="menu-intro">
      <p>{site.menuPage.eyebrow}</p>
      <h1>{site.menuPage.headline}</h1>
      <span>{site.menuPage.intro}</span>
    </section>
    <figure class="menu-image"><img src={withBase(menuMedia[0].src)} alt={menuMedia[0].alt} /><figcaption>{menuMedia[0].credit}</figcaption></figure>
    <MenuList title={site.menuPage.coreTitle} items={coreMenu} />
    <figure class="menu-image menu-image--wide"><img src={withBase(menuMedia[1].src)} alt={menuMedia[1].alt} /><figcaption>{menuMedia[1].credit}</figcaption></figure>
    <MenuList title={site.menuPage.seasonalTitle} items={seasonalMenu} />
  </main>
  <Footer />
</BaseLayout>
